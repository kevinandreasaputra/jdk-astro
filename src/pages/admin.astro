---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <!-- Page Title: Admin Dashboard - JDK Entertainment -->
    <main>
        <!-- Navigation (Sidebar) will be injected here by admin-layout.js -->
        <!-- We need to ensure admin-layout.js injects compatible HTML or we style it via CSS -->

        <div class="ml-0 md:ml-64 transition-all duration-300 min-h-screen">

            <!-- Top Header -->
            <header
                class="bg-white border-b border-slate-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
                <div>
                    <h1 class="text-xl font-bold text-slate-800">Dashboard Overview</h1>
                    <p class="text-sm text-slate-500">Welcome back, Admin</p>
                </div>
                <div class="flex items-center gap-4">
                    <div id="activePromoContainer" class="flex gap-2">
                        <!-- Dynamic Badges -->
                    </div>
                    <!-- Profile Dropdown or Info could go here -->
                </div>
            </header>

            <div class="p-6 max-w-7xl mx-auto space-y-8">

                <!-- Stats Grid -->
                <section id="statsSection" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- Stat Card 1 -->
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Total
                            Members</span>
                        <div class="flex items-end justify-between">
                            <span class="text-3xl font-bold text-slate-800" id="totalMembers">0</span>
                            <span class="material-symbols-outlined text-blue-500 bg-blue-50 p-2 rounded-lg">group</span>
                        </div>
                    </div>

                    <!-- Stat Card 2 -->
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Active
                            Admins</span>
                        <div class="flex items-end justify-between">
                            <span class="text-3xl font-bold text-slate-800" id="totalAdmins">0</span>
                            <span
                                class="material-symbols-outlined text-purple-500 bg-purple-50 p-2 rounded-lg">admin_panel_settings</span>
                        </div>
                    </div>

                    <!-- Stat Card 3 -->
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">VIP
                            Members</span>
                        <div class="flex items-end justify-between">
                            <span class="text-3xl font-bold text-slate-800" id="totalVIP">0</span>
                            <span
                                class="material-symbols-outlined text-yellow-500 bg-yellow-50 p-2 rounded-lg">stars</span>
                        </div>
                    </div>

                    <!-- Stat Card 4 -->
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Points
                            Circulation</span>
                        <div class="flex items-end justify-between">
                            <span class="text-3xl font-bold text-slate-800" id="totalPoints">0</span>
                            <span
                                class="material-symbols-outlined text-orange-500 bg-orange-50 p-2 rounded-lg">monetization_on</span>
                        </div>
                    </div>
                </section>

                <!-- Action Required -->
                <section id="actionRequiredSection">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <div class="bg-red-100 p-2 rounded-lg">
                                <span class="material-symbols-outlined text-red-600">notification_important</span>
                            </div>
                            <div>
                                <h3 class="font-semibold text-slate-800 text-base">Action Required</h3>
                                <p class="text-xs text-slate-400">Items waiting for your review</p>
                            </div>
                        </div>
                        <button onclick="loadActionRequired()"
                            class="text-slate-400 hover:text-slate-600 transition-colors p-2 rounded-lg hover:bg-slate-100"
                            title="Refresh">
                            <span class="material-symbols-outlined text-[20px]">refresh</span>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                        <!-- Product Approval -->
                        <a href="/admin_marketplace"
                            class="group bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:border-amber-300 hover:shadow-md transition-all relative overflow-hidden">
                            <div class="flex items-center justify-between mb-3">
                                <span
                                    class="material-symbols-outlined text-amber-500 bg-amber-50 p-2 rounded-lg text-[20px]">shopping_bag</span>
                                <span id="countProducts" class="text-2xl font-bold text-slate-800">-</span>
                            </div>
                            <p class="text-sm font-semibold text-slate-700 mb-0.5">Product Review</p>
                            <p class="text-[11px] text-slate-400">Produk menunggu approval</p>
                            <div id="dotProducts"
                                class="hidden absolute top-3 right-3 w-2.5 h-2.5 bg-red-500 rounded-full animate-pulse">
                            </div>
                        </a>

                        <!-- Radio Requests -->
                        <a href="/admin_radio"
                            class="group bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:border-violet-300 hover:shadow-md transition-all relative overflow-hidden">
                            <div class="flex items-center justify-between mb-3">
                                <span
                                    class="material-symbols-outlined text-violet-500 bg-violet-50 p-2 rounded-lg text-[20px]">radio</span>
                                <span id="countRadio" class="text-2xl font-bold text-slate-800">-</span>
                            </div>
                            <p class="text-sm font-semibold text-slate-700 mb-0.5">Radio Requests</p>
                            <p class="text-[11px] text-slate-400">Request lagu pending</p>
                            <div id="dotRadio"
                                class="hidden absolute top-3 right-3 w-2.5 h-2.5 bg-red-500 rounded-full animate-pulse">
                            </div>
                        </a>

                        <!-- Rekber Verification -->
                        <a href="/admin-rekber"
                            class="group bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:border-blue-300 hover:shadow-md transition-all relative overflow-hidden">
                            <div class="flex items-center justify-between mb-3">
                                <span
                                    class="material-symbols-outlined text-blue-500 bg-blue-50 p-2 rounded-lg text-[20px]">verified_user</span>
                                <span id="countRekberVerify" class="text-2xl font-bold text-slate-800">-</span>
                            </div>
                            <p class="text-sm font-semibold text-slate-700 mb-0.5">Rekber Verifikasi</p>
                            <p class="text-[11px] text-slate-400">Transaksi perlu verifikasi</p>
                            <div id="dotRekberVerify"
                                class="hidden absolute top-3 right-3 w-2.5 h-2.5 bg-red-500 rounded-full animate-pulse">
                            </div>
                        </a>

                        <!-- Rekber Disputes -->
                        <a href="/admin-rekber"
                            class="group bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:border-rose-300 hover:shadow-md transition-all relative overflow-hidden">
                            <div class="flex items-center justify-between mb-3">
                                <span
                                    class="material-symbols-outlined text-rose-500 bg-rose-50 p-2 rounded-lg text-[20px]">gavel</span>
                                <span id="countRekberDispute" class="text-2xl font-bold text-slate-800">-</span>
                            </div>
                            <p class="text-sm font-semibold text-slate-700 mb-0.5">Rekber Dispute</p>
                            <p class="text-[11px] text-slate-400">Sengketa butuh mediasi</p>
                            <div id="dotRekberDispute"
                                class="hidden absolute top-3 right-3 w-2.5 h-2.5 bg-red-500 rounded-full animate-pulse">
                            </div>
                        </a>

                        <!-- Event Registrations -->
                        <a href="/admin_events"
                            class="group bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:border-emerald-300 hover:shadow-md transition-all relative overflow-hidden">
                            <div class="flex items-center justify-between mb-3">
                                <span
                                    class="material-symbols-outlined text-emerald-500 bg-emerald-50 p-2 rounded-lg text-[20px]">event_available</span>
                                <span id="countEventReg" class="text-2xl font-bold text-slate-800">-</span>
                            </div>
                            <p class="text-sm font-semibold text-slate-700 mb-0.5">Event Registrasi</p>
                            <p class="text-[11px] text-slate-400">Pendaftaran perlu approval</p>
                            <div id="dotEventReg"
                                class="hidden absolute top-3 right-3 w-2.5 h-2.5 bg-red-500 rounded-full animate-pulse">
                            </div>
                        </a>
                    </div>
                </section>

                <!-- Quick Actions & Settings -->
                <section id="settingsSection" class="grid lg:grid-cols-3 gap-6">
                    <!-- System Config -->
                    <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                            <h3 class="font-semibold text-slate-800 flex items-center gap-2">
                                <span class="material-symbols-outlined text-slate-500">tune</span> System Configuration
                            </h3>
                            <button id="saveSettingsBtn" onclick="saveSystemSettings()"
                                class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
                                <span class="material-symbols-outlined text-[18px]">save</span> Save Changes
                            </button>
                        </div>

                        <div class="p-6 grid md:grid-cols-2 gap-8">
                            <!-- Group 1 -->
                            <div class="space-y-4">
                                <h4
                                    class="text-xs font-bold text-slate-400 uppercase tracking-widest border-b pb-2 mb-2">
                                    Marketplace Rules</h4>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Min XP to Upload
                                        Box</label>
                                    <input type="number" id="settingMinUploadXp"
                                        class="input-field bg-slate-50 focus:bg-white" min="0">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Min XP for
                                        Rekber</label>
                                    <input type="number" id="settingMinRekberXp"
                                        class="input-field bg-slate-50 focus:bg-white" min="0">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Min Level for
                                        Stickers</label>
                                    <input type="number" id="settingMinStickerLevel"
                                        class="input-field bg-slate-50 focus:bg-white" min="0">
                                </div>

                                <div
                                    class="flex items-center justify-between bg-amber-50 p-3 rounded-lg border border-amber-200">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700">Auto-Approve
                                            Products</label>
                                        <p class="text-[10px] text-slate-500">Barang langsung tayang tanpa review admin
                                        </p>
                                    </div>
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" id="settingAutoApprove" class="sr-only peer">
                                        <div
                                            class="w-10 h-5 bg-slate-300 peer-focus:ring-2 peer-focus:ring-amber-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-amber-500 after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all">
                                        </div>
                                    </label>
                                </div>

                                <h4
                                    class="text-xs font-bold text-slate-400 uppercase tracking-widest border-b pb-2 mb-2 pt-4">
                                    JDK Radio Settings</h4>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-1">Cost
                                            (Points)</label>
                                        <input type="number" id="settingRadioPointCost"
                                            class="input-field bg-slate-50 focus:bg-white" min="0">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-1">Limit (Min)</label>
                                        <input type="number" id="settingRadioRateLimit"
                                            class="input-field bg-slate-50 focus:bg-white" min="0">
                                    </div>
                                </div>
                            </div>

                            <!-- Group 2 -->
                            <div class="space-y-4">
                                <h4
                                    class="text-xs font-bold text-slate-400 uppercase tracking-widest border-b pb-2 mb-2">
                                    Engagement Rewards</h4>

                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-1">XP / Login</label>
                                        <input type="number" id="settingXpPerLogin"
                                            class="input-field bg-slate-50 focus:bg-white" min="0">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-1">Points /
                                            Login</label>
                                        <input type="number" id="settingPointsPerLogin"
                                            class="input-field bg-slate-50 focus:bg-white" min="0">
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Referral Rewards
                                        (Bank/Newbie)</label>
                                    <div class="grid grid-cols-2 gap-4">
                                        <input type="number" id="settingReferrerReward"
                                            class="input-field bg-slate-50 focus:bg-white" placeholder="Referrer">
                                        <input type="number" id="settingRefereeReward"
                                            class="input-field bg-slate-50 focus:bg-white" placeholder="Referee">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Promo Periods -->
                        <div class="px-6 py-4 bg-slate-50 border-t border-slate-100">
                            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Double Rewards
                                Windows</h4>
                            <div class="grid md:grid-cols-2 gap-4">
                                <div class="bg-blue-50/50 p-3 rounded-lg border border-blue-100">
                                    <label class="block text-xs font-semibold text-blue-800 mb-2">Double XP
                                        Window</label>
                                    <div class="flex gap-2 text-xs">
                                        <input type="datetime-local" id="settingDoubleXpStart"
                                            class="bg-white border border-blue-200 rounded px-2 py-1 w-full text-slate-600">
                                        <span class="self-center text-slate-400">to</span>
                                        <input type="datetime-local" id="settingDoubleXpEnd"
                                            class="bg-white border border-blue-200 rounded px-2 py-1 w-full text-slate-600">
                                    </div>
                                </div>
                                <div class="bg-orange-50/50 p-3 rounded-lg border border-orange-100">
                                    <label class="block text-xs font-semibold text-orange-800 mb-2">Double Points
                                        Window</label>
                                    <div class="flex gap-2 text-xs">
                                        <input type="datetime-local" id="settingDoublePointsStart"
                                            class="bg-white border border-orange-200 rounded px-2 py-1 w-full text-slate-600">
                                        <span class="self-center text-slate-400">to</span>
                                        <input type="datetime-local" id="settingDoublePointsEnd"
                                            class="bg-white border border-orange-200 rounded px-2 py-1 w-full text-slate-600">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Navigation Links -->
                    <div class="space-y-4">
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow cursor-pointer group"
                            onclick="showLevelsSection()">
                            <div class="flex items-center gap-4">
                                <div
                                    class="bg-blue-100 text-blue-600 p-3 rounded-lg group-hover:bg-blue-600 group-hover:text-white transition-colors">
                                    <span class="material-symbols-outlined">trending_up</span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-slate-800">XP & Levels</h4>
                                    <p class="text-xs text-slate-500">Configure XP thresholds</p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow cursor-pointer group"
                            onclick="showRanksSection()">
                            <div class="flex items-center gap-4">
                                <div
                                    class="bg-purple-100 text-purple-600 p-3 rounded-lg group-hover:bg-purple-600 group-hover:text-white transition-colors">
                                    <span class="material-symbols-outlined">shield</span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-slate-800">Rank System</h4>
                                    <p class="text-xs text-slate-500">Manage user ranks</p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow cursor-pointer group"
                            onclick="window.location.href='/admin_gallery_upload.html'">
                            <div class="flex items-center gap-4">
                                <div
                                    class="bg-yellow-100 text-yellow-600 p-3 rounded-lg group-hover:bg-yellow-600 group-hover:text-white transition-colors">
                                    <span class="material-symbols-outlined">collections</span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-slate-800">Gallery Manager</h4>
                                    <p class="text-xs text-slate-500">Upload & tag photos</p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow cursor-pointer group"
                            onclick="window.location.href='/admin-rekber.html'">
                            <div class="flex items-center gap-4">
                                <div
                                    class="bg-emerald-100 text-emerald-600 p-3 rounded-lg group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                                    <span class="material-symbols-outlined">handshake</span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-slate-800">Rekber System</h4>
                                    <p class="text-xs text-slate-500">Escrow transactions</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Members Table Section -->
                <section id="membersSection"
                    class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col min-h-[500px]">
                    <div
                        class="p-6 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-4">
                        <h2 class="text-lg font-bold text-slate-800">Member Management</h2>

                        <div class="flex w-full sm:w-auto gap-3">
                            <div class="relative flex-1 sm:w-64">
                                <span
                                    class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 material-symbols-outlined text-sm">search</span>
                                <input type="text" id="searchMember" placeholder="Search by name, ID..."
                                    class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none"
                                    onkeyup="filterMembers()">
                            </div>
                            <button onclick="loadAllMembers()"
                                class="bg-slate-100 text-slate-600 hover:bg-slate-200 p-2 rounded-lg transition-colors"
                                title="Refresh">
                                <span class="material-symbols-outlined text-sm">refresh</span>
                            </button>
                        </div>
                    </div>

                    <div class="overflow-x-auto flex-1">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr>
                                    <th class="whitespace-nowrap w-16 text-center">Avatar</th>
                                    <th class="whitespace-nowrap cursor-pointer hover:bg-slate-50"
                                        onclick="sortBy('username')">Username</th>
                                    <th class="whitespace-nowrap cursor-pointer hover:bg-slate-50"
                                        onclick="sortBy('jdk_id')">ID</th>
                                    <th class="whitespace-nowrap">Role</th>
                                    <th class="whitespace-nowrap">Status</th>
                                    <th class="whitespace-nowrap">Rank</th>
                                    <th class="whitespace-nowrap w-32">Email</th>
                                    <th class="whitespace-nowrap text-right cursor-pointer hover:bg-slate-50"
                                        onclick="sortBy('xp')">XP</th>
                                    <th class="whitespace-nowrap text-right cursor-pointer hover:bg-slate-50"
                                        onclick="sortBy('current_points')">Points</th>
                                    <th class="whitespace-nowrap text-right cursor-pointer hover:bg-slate-50"
                                        onclick="sortBy('coin')">Coins</th>
                                    <th class="whitespace-nowrap text-right cursor-pointer hover:bg-slate-50"
                                        onclick="sortBy('last_login')">Last Login</th>
                                </tr>
                            </thead>
                            <tbody id="memberTableBody" class="text-sm divide-y divide-slate-100">
                                <!-- JS Injection -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Controls -->
                    <div id="paginationControls"
                        class="p-4 border-t border-slate-100 flex justify-between items-center bg-slate-50 rounded-b-xl">
                        <span class="text-xs text-slate-500" id="paginationInfo">Showing 0-0 of 0</span>
                        <div class="flex gap-2">
                            <button id="prevPageBtn"
                                class="px-3 py-1 bg-white border border-slate-300 rounded text-xs font-medium text-slate-600 disabled:opacity-50 hover:bg-slate-50 transition-colors">Previous</button>
                            <button id="nextPageBtn"
                                class="px-3 py-1 bg-white border border-slate-300 rounded text-xs font-medium text-slate-600 disabled:opacity-50 hover:bg-slate-50 transition-colors">Next</button>
                        </div>
                    </div>
                </section>

                <!-- Broadcast Section -->
                <section id="announcementsSection" class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="p-2 bg-yellow-100 text-yellow-600 rounded-lg">
                            <span class="material-symbols-outlined">campaign</span>
                        </div>
                        <div>
                            <h2 class="text-lg font-bold text-slate-800">System Broadcast</h2>
                            <p class="text-sm text-slate-500">Send announcements to all users</p>
                        </div>
                    </div>

                    <div class="grid lg:grid-cols-2 gap-8">
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Title</label>
                                <input type="text" id="bc_title" class="input-field" placeholder="Brief title...">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Message</label>
                                <div class="relative">
                                    <textarea id="bc_content" class="input-field min-h-[120px]"
                                        placeholder="Your message..."></textarea>
                                    <button onclick="toggleStickerPicker('bc_content')"
                                        class="absolute right-2 bottom-2 text-xs bg-slate-100 hover:bg-slate-200 px-2 py-1 rounded text-slate-600 font-medium transition-colors">
                                        + Sticker
                                    </button>
                                </div>
                            </div>
                            <button onclick="sendBroadcast()" class="btn btn-primary w-full py-2.5">
                                <span class="material-symbols-outlined text-sm mr-2">send</span> Publish Announcement
                            </button>
                        </div>

                        <!-- Broadcast History -->
                        <div class="bg-slate-50 rounded-xl border border-slate-200 p-4">
                            <h4 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">Recent
                                Broadcasts
                            </h4>
                            <div class="overflow-y-auto max-h-[250px] space-y-2" id="broadcastTableBody">
                                <!-- JS Injection -->
                                <div class="text-center py-8 text-slate-400 text-sm">Loading history...</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Sections normally hidden (Ranks, Levels) -->
                <div id="ranksSection"
                    class="hidden bg-white rounded-xl border border-slate-200 shadow-sm p-6 relative">
                    <button onclick="hideRanksSection()"
                        class="absolute right-4 top-4 text-slate-400 hover:text-slate-700">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                    <h2 class="text-xl font-bold text-slate-800 mb-4">Rank Management</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-slate-100 text-xs uppercase text-slate-500">
                                <tr>
                                    <th class="p-3 rounded-l-lg">Type</th>
                                    <th class="p-3">Name</th>
                                    <th class="p-3">Min Level</th>
                                    <th class="p-3">Min XP</th>
                                    <th class="p-3">Badge</th>
                                    <th class="p-3 rounded-r-lg">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="ranksTableBody"></tbody>
                        </table>
                    </div>
                    <button onclick="openRankModal()"
                        class="mt-4 px-4 py-2 bg-purple-600 text-white rounded-lg text-sm font-medium hover:bg-purple-700 transition-colors">
                        + Add New Rank
                    </button>
                </div>

                <div id="levelsSection"
                    class="hidden bg-white rounded-xl border border-slate-200 shadow-sm p-6 relative">
                    <button onclick="hideLevelsSection()"
                        class="absolute right-4 top-4 text-slate-400 hover:text-slate-700">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-slate-800">Level Configuration</h2>
                        <button onclick="autoScaleLevels()"
                            class="px-3 py-1.5 bg-blue-50 text-blue-600 rounded-lg text-xs font-semibold hover:bg-blue-100 transition-colors">
                            Auto-Scale Tool
                        </button>
                    </div>

                    <div class="grid lg:grid-cols-3 gap-6">
                        <!-- Config Tools would go here (simplified for this view) -->
                        <div class="col-span-3">
                            <div class="overflow-y-auto max-h-[500px] border rounded-lg">
                                <table class="w-full">
                                    <thead class="bg-slate-100 sticky top-0">
                                        <tr>
                                            <th class="p-2 text-xs">Lvl</th>
                                            <th class="p-2 text-xs">Rank</th>
                                            <th class="p-2 text-xs">Min XP</th>
                                            <th class="p-2 text-xs">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="levelsTableBody"></tbody>
                                </table>
                            </div>
                            <button onclick="saveAllLevels()"
                                class="mt-4 w-full py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors">
                                Save All Levels
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <!-- Modals (retaining logic hooks, updating styles) -->

        <!-- Edit Member Modal -->
        <div id="editMemberModal"
            class="fixed inset-0 hidden items-center justify-center z-50 bg-slate-900/50 backdrop-blur-sm">
            <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
                <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                    <h3 class="text-lg font-bold text-slate-800">Edit Member</h3>
                    <button onclick="closeEditMemberModal()"
                        class="text-slate-400 hover:text-slate-600 transition-colors">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <div class="p-6 overflow-y-auto space-y-4">
                    <input type="hidden" id="editMemberId">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-500 mb-1">Username</label>
                            <input type="text" id="editUsername" class="input-field">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-500 mb-1">Full Name</label>
                            <input type="text" id="editFullName" class="input-field">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-500 mb-1">Role</label>
                            <select id="editUserLevel" class="input-field" onchange="togglePermissionSection()">
                                <option value="Member">Member</option>
                                <option value="VIP">VIP</option>
                                <option value="Host">Host</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-500 mb-1">Status</label>
                            <select id="editStatus" class="input-field">
                                <option value="active">Active</option>
                                <option value="suspended">Suspended</option>
                                <option value="banned">Banned</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-3 bg-slate-50 p-3 rounded-lg border border-slate-200">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase">XP</label>
                            <input type="number" id="editXp"
                                class="w-full bg-white border border-slate-200 rounded p-1 text-sm">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase">Points</label>
                            <input type="number" id="editPoints" readonly
                                class="w-full bg-slate-100 border border-slate-200 rounded p-1 text-sm text-slate-500 cursor-not-allowed">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase">Coin</label>
                            <input type="number" id="editCoin" readonly
                                class="w-full bg-slate-100 border border-slate-200 rounded p-1 text-sm text-slate-500 cursor-not-allowed">
                        </div>
                    </div>

                    <!-- Contact Info -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">WhatsApp</label>
                        <input type="text" id="editWhatsapp" class="input-field">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Domicile</label>
                        <input type="text" id="editDomicile" class="input-field">
                    </div>

                    <!-- Admin Permissions (Hidden by default) -->
                    <div id="adminPermissionSection"
                        class="hidden p-4 bg-purple-50 rounded-lg border border-purple-100">
                        <h4 class="text-xs font-bold text-purple-800 uppercase mb-2">Admin Access Control</h4>
                        <div class="grid grid-cols-2 gap-2" id="permissionCheckboxes">
                            <!-- Checkboxes injected or hardcoded here need to match JS -->
                            <label class="flex items-center gap-2 text-xs text-purple-900"><input type="checkbox"
                                    value="dashboard" class="perm-check"> Dashboard</label>
                            <label class="flex items-center gap-2 text-xs text-purple-900"><input type="checkbox"
                                    value="members" class="perm-check"> Members</label>
                            <label class="flex items-center gap-2 text-xs text-purple-900"><input type="checkbox"
                                    value="slider" class="perm-check"> Slider</label>
                            <label class="flex items-center gap-2 text-xs text-purple-900"><input type="checkbox"
                                    value="badges" class="perm-check"> Badges</label>
                            <label class="flex items-center gap-2 text-xs text-purple-900"><input type="checkbox"
                                    value="coins" class="perm-check"> Coins</label>
                            <label class="flex items-center gap-2 text-xs text-purple-900"><input type="checkbox"
                                    value="events" class="perm-check"> Events</label>
                            <label class="flex items-center gap-2 text-xs text-purple-900"><input type="checkbox"
                                    value="games" class="perm-check"> Games</label>
                            <label class="flex items-center gap-2 text-xs text-purple-900"><input type="checkbox"
                                    value="referrals" class="perm-check"> Referrals</label>
                            <label class="flex items-center gap-2 text-xs text-purple-900"><input type="checkbox"
                                    value="radio" class="perm-check"> Radio</label>
                            <label class="flex items-center gap-2 text-xs text-purple-900"><input type="checkbox"
                                    value="marketplace" class="perm-check"> Marketplace</label>
                        </div>
                        <div class="mt-2 pt-2 border-t border-purple-200">
                            <label class="flex items-center gap-2 text-xs font-bold text-red-600"><input type="checkbox"
                                    id="isSuperAdmin"> SUPER ADMIN</label>
                        </div>
                    </div>

                    <!-- Email Section -->
                    <div id="emailConfirmSection"
                        class="p-3 bg-yellow-50 border border-yellow-100 rounded-lg flex justify-between items-center">
                        <span id="editEmailStatusText" class="text-xs text-yellow-800">Email not confirmed.</span>
                        <button id="btnManualConfirm" onclick="manualConfirmEmail()"
                            class="text-xs bg-yellow-200 hover:bg-yellow-300 text-yellow-900 px-2 py-1 rounded">Confirm
                            Manually</button>
                    </div>

                    <!-- Hidden inputs for ID reference if needed -->
                    <input type="hidden" id="editReferralCode">
                    <input type="hidden" id="editReferredBy">

                </div>

                <div class="p-4 border-t border-slate-100 bg-slate-50 flex gap-3">
                    <button id="deleteMemberBtn" onclick="handleDeleteFromModal()"
                        class="px-4 py-2 border border-red-200 text-red-600 hover:bg-red-50 rounded-lg text-sm font-medium transition-colors">Delete
                        User</button>
                    <div class="flex-1"></div>
                    <button onclick="closeEditMemberModal()"
                        class="px-4 py-2 text-slate-600 hover:text-slate-800 text-sm font-medium">Cancel</button>
                    <button id="saveMemberBtn" onclick="saveMemberChanges()"
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors shadow-sm">Save
                        Changes</button>
                </div>
            </div>
        </div>

        <!-- Balance Modal -->
        <div id="coinModal"
            class="fixed inset-0 hidden items-center justify-center z-50 bg-slate-900/50 backdrop-blur-sm">
            <div class="bg-white w-full max-w-md rounded-2xl shadow-xl overflow-hidden">
                <div class="p-6 bg-slate-50 border-b border-slate-100 text-center">
                    <img id="cm_avatar" src="" class="w-16 h-16 rounded-full mx-auto shadow-sm mb-3 bg-white p-1">
                    <h3 class="font-bold text-lg text-slate-800" id="bm_title">Manage Balance</h3>
                    <p class="text-sm text-slate-500" id="cm_username">User</p>
                </div>
                <div class="p-6 space-y-4">
                    <input type="hidden" id="cm_userId">
                    <input type="hidden" id="cm_type">

                    <div class="text-center p-4 bg-blue-50 rounded-xl border border-blue-100">
                        <span class="block text-xs font-semibold text-blue-400 uppercase mb-1" id="bm_badge">Current
                            Balance</span>
                        <span class="text-3xl font-bold text-blue-700" id="cm_currentCoin">0</span>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Amount to Adjust</label>
                        <input type="number" id="cm_amount" class="input-field text-lg font-mono" placeholder="0">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Description (Reason)</label>
                        <input type="text" id="cm_description" class="input-field" placeholder="Admin Adjustment...">
                    </div>

                    <div class="grid grid-cols-2 gap-3 pt-2">
                        <button onclick="updateBalance('add')"
                            class="balance-action-btn py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition-colors">+
                            Add</button>
                        <button onclick="updateBalance('subtract')"
                            class="balance-action-btn py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-colors">-
                            Subtract</button>
                    </div>
                </div>
                <div class="p-4 bg-slate-50 border-t border-slate-100 text-center">
                    <button onclick="viewHistoryFromModal()" class="text-xs text-blue-600 hover:underline">View
                        Transaction
                        History</button>
                    <div class="mt-2">
                        <button onclick="closeCoinModal()"
                            class="text-sm text-slate-500 hover:text-slate-700">Close</button>
                    </div>
                </div>
                <!-- Hidden date element if needed by JS -->
                <span id="cm_date" class="hidden"></span>
            </div>
        </div>

        <!-- History Modal -->
        <div id="historyModal"
            class="fixed inset-0 hidden items-center justify-center z-[60] bg-slate-900/50 backdrop-blur-sm">
            <div class="bg-white w-full max-w-2xl rounded-2xl shadow-xl overflow-hidden flex flex-col max-h-[80vh]">
                <div class="p-4 border-b border-slate-100 flex justify-between items-center">
                    <h3 class="font-bold text-slate-800" id="historyUsername">Transaction History</h3>
                    <button onclick="closeHistoryModal()"><span
                            class="material-symbols-outlined text-slate-400">close</span></button>
                </div>
                <div class="flex-1 overflow-y-auto p-0">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 text-xs text-slate-500 uppercase sticky top-0">
                            <tr>
                                <th class="p-3">Date</th>
                                <th class="p-3">Amount</th>
                                <th class="p-3">Desc</th>
                                <th class="p-3">Type</th>
                            </tr>
                        </thead>
                        <tbody id="historyTableBody" class="text-sm"></tbody>
                    </table>
                </div>
            </div>
        </div>


        <!-- Sticker Picker (Hidden) -->
        <div id="stickerPicker"
            class="hidden absolute bg-white shadow-xl border border-slate-200 rounded-xl p-3 z-50 w-64 max-h-64 overflow-y-auto">
            <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-bold text-slate-500">Select Sticker</span>
                <button onclick="toggleStickerPicker()" class="text-slate-400 hover:text-slate-600">&times;</button>
            </div>
            <div id="stickerList" class="grid grid-cols-4 gap-2"></div>
        </div>

    </main>

</Layout>
