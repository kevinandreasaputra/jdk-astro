---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Manage Badges - JDK Admin">
    <main class="ml-0 md:ml-64 transition-all duration-300 min-h-screen">

        <!-- Header -->
        <header
            class="bg-white border-b border-slate-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-slate-800">Manage Badges</h1>
                <p class="text-sm text-slate-500">Achievements and Awards</p>
            </div>
            <button onclick="openBadgeModal()"
                class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px]">military_tech</span> Add Badge
            </button>
        </header>

        <div class="p-6 max-w-7xl mx-auto space-y-6">

            <!-- Filters -->
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                <div class="relative max-w-md">
                    <span
                        class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">search</span>
                    <input type="text" id="searchBadge" onkeyup="filterBadges()" placeholder="Search badges..."
                        class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none">
                </div>
            </div>

            <!-- Badges Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="badgeContainer">
                <div class="col-span-full py-20 text-center flex flex-col items-center justify-center text-slate-400">
                    <span class="material-symbols-outlined text-4xl mb-2 animate-spin">sync</span>
                    <span class="text-sm font-medium">Loading badges...</span>
                </div>
            </div>

        </div>
    </main>




    <!-- Restored Modals -->
    <!-- Badge Modal -->
    <div id="badgeModal" class="fixed inset-0 hidden items-center justify-center z-50 bg-slate-900/50 backdrop-blur-sm">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-xl overflow-hidden flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <div class="flex items-center gap-2">
                    <h3 class="text-lg font-bold text-slate-800" id="modalTitle">Add New Badge</h3>
                </div>
                <button onclick="closeBadgeModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form onsubmit="event.preventDefault(); saveBadge();" class="flex flex-col flex-1 min-h-0">
                <div class="p-6 space-y-5">
                    <input type="hidden" id="badgeId">

                    <div class="flex justify-center mb-2">
                        <div id="modalIcon"
                            class="text-6xl bg-slate-50 rounded-full w-24 h-24 flex items-center justify-center border border-slate-100 shadow-sm">
                            🏆</div>
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500">Badge Title</label>
                        <input type="text" id="badgeTitle" class="input-field" placeholder="e.g. The Champion">
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500">Description</label>
                        <textarea id="badgeDescription" class="input-field h-20 resize-none text-sm"
                            placeholder="How to get this badge..."></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold text-slate-500">Icon (Emoji)</label>
                            <input type="text" id="badgeIcon" class="input-field text-center text-lg" placeholder="🏆"
                                oninput="document.getElementById('modalIcon').innerText = this.value || '🏆'">
                        </div>
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold text-slate-500">Category</label>
                            <select id="badgeCategory" class="input-field">
                                <option value="Event">Event</option>
                                <option value="Activity">Activity</option>
                                <option value="Special">Special</option>
                                <option value="Legacy">Legacy</option>
                                <option value="Hidden">Hidden (Secret)</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 p-3 bg-slate-50 rounded-lg border border-slate-200">
                        <input type="checkbox" id="badgeIsHidden"
                            class="w-4 h-4 text-purple-600 rounded border-slate-300 focus:ring-purple-500">
                        <label for="badgeIsHidden" class="text-xs font-bold text-slate-600 cursor-pointer">Secret
                            Achievement (Hidden)</label>
                    </div>
                </div>

                <div class="p-4 border-t border-slate-100 bg-slate-50 flex gap-3">
                    <button type="button" id="btnDeleteBadge" onclick="handleDeleteFromModal()"
                        class="hidden px-4 py-2 border border-red-200 text-red-600 hover:bg-red-50 rounded-lg text-sm font-medium transition-colors">
                        Delete
                    </button>
                    <div class="flex-1"></div>
                    <button type="button" onclick="closeBadgeModal()"
                        class="px-4 py-2 text-slate-600 hover:text-slate-800 text-sm font-medium">Cancel</button>
                    <button type="submit"
                        class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors shadow-sm">Save
                        Badge</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts -->

<script src="../js/pages/admin-achievements.js"></script>
</AdminLayout>
