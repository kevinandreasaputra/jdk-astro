---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Manage Coins - Admin Dashboard">
    <main class="ml-0 md:ml-64 transition-all duration-300 min-h-screen">

        <!-- Header -->
        <header
            class="bg-white border-b border-slate-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-slate-800">Manage Coins</h1>
                <p class="text-sm text-slate-500">Member balances and transaction history</p>
            </div>
        </header>

        <div class="p-6 max-w-7xl mx-auto space-y-6">

            <!-- Main Content -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-4 border-b border-slate-100 flex items-center gap-4">
                    <div class="relative flex-1 max-w-md">
                        <span
                            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">search</span>
                        <input type="text" id="searchMember" placeholder="Search username..."
                            class="w-full pl-9 pr-8 py-2 border border-slate-200 rounded-lg text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none">
                        <button onclick="document.getElementById('searchMember').value = ''; filterMembers();"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-red-500">
                            <span class="material-symbols-outlined text-sm">close</span>
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr
                                class="bg-slate-50 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase">
                                <th class="px-6 py-4">Member</th>
                                <th class="px-6 py-4 text-center">Current Coin</th>
                                <th class="px-6 py-4 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="memberTableBody" class="divide-y divide-slate-100">
                            <tr>
                                <td colspan="3" class="px-6 py-8 text-center text-slate-500">
                                    <div class="flex flex-col items-center">
                                        <span
                                            class="material-symbols-outlined text-3xl animate-spin mb-2 text-slate-300">sync</span>
                                        <span class="text-sm">Loading members...</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                <div class="p-4 border-t border-slate-100 flex items-center justify-between bg-white">
                    <div class="text-sm text-slate-500">
                        Showing <span id="pageInfoStart" class="font-medium">0</span> to <span id="pageInfoEnd"
                            class="font-medium">0</span> of <span id="pageInfoTotal" class="font-medium">0</span>
                        members
                    </div>
                    <div class="flex gap-2">
                        <button id="btnPrevPage" onclick="prevPage()" disabled
                            class="px-3 py-1 border border-slate-200 rounded text-sm disabled:opacity-50 hover:bg-slate-50 transition-colors">
                            Previous
                        </button>
                        <span id="pageIndicator"
                            class="px-3 py-1 text-sm font-medium bg-slate-50 rounded border border-slate-100">
                            Page 1
                        </span>
                        <button id="btnNextPage" onclick="nextPage()" disabled
                            class="px-3 py-1 border border-slate-200 rounded text-sm disabled:opacity-50 hover:bg-slate-50 transition-colors">
                            Next
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>




    <!-- Restored Modals -->
    <!-- Manage Coin Modal -->
    <div id="coinModal" class="fixed inset-0 hidden items-center justify-center z-50 bg-slate-900/50 backdrop-blur-sm">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-xl overflow-hidden flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <h3 class="text-lg font-bold text-slate-800">Manage Member Coin</h3>
                <button onclick="closeCoinModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="p-6">
                <!-- User Info -->
                <div class="flex flex-col items-center mb-6">
                    <img id="cm_avatar" src=""
                        class="w-20 h-20 rounded-full border-2 border-slate-200 mb-3 object-cover shadow-sm">
                    <h4 id="cm_username" class="font-bold text-lg text-slate-800"></h4>
                    <div class="text-slate-500 font-medium flex items-center gap-1">
                        Current: <span id="cm_currentCoin" class="text-amber-500 font-bold text-lg">0</span> 🪙
                    </div>

                    <div
                        class="mt-3 bg-slate-50 p-3 rounded-lg border border-slate-100 text-xs space-y-1 w-full text-center">
                        <p class="text-slate-500">Last Update: <span id="cm_date"
                                class="font-semibold text-slate-700"></span></p>
                        <p class="text-slate-500">By Admin: <span id="cm_admin"
                                class="font-semibold text-blue-600"></span></p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Coin Amount</label>
                        <input type="number" id="cm_amount" class="input-field" placeholder="0">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Reason / Description</label>
                        <textarea id="cm_description" class="input-field resize-none" rows="2"
                            placeholder="e.g. Event Reward, Refund..."></textarea>
                    </div>
                </div>

                <input type="hidden" id="cm_userId">
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex gap-3">
                <button onclick="updateCoin('add')"
                    class="flex-1 btn bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-lg">add_circle</span> Add
                </button>
                <button onclick="updateCoin('subtract')"
                    class="flex-1 btn bg-rose-500 hover:bg-rose-600 text-white shadow-sm flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-lg">do_not_disturb_on</span> Subtract
                </button>
            </div>
        </div>
    </div>

    <!-- History Modal -->
    <div id="historyModal"
        class="fixed inset-0 hidden items-center justify-center z-50 bg-slate-900/50 backdrop-blur-sm">
        <div class="bg-white w-full max-w-2xl rounded-2xl shadow-xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <div>
                    <h3 class="text-lg font-bold text-slate-800">Transaction History</h3>
                    <p class="text-xs text-slate-500">History for <span id="historyUsername"
                            class="font-semibold">...</span></p>
                </div>
                <button onclick="closeHistoryModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="overflow-y-auto flex-1 p-0">
                <table class="w-full text-left text-sm">
                    <thead
                        class="bg-slate-50 border-b border-slate-100 sticky top-0 text-xs font-semibold text-slate-500 uppercase">
                        <tr>
                            <th class="p-3">Time</th>
                            <th class="p-3">Amount</th>
                            <th class="p-3">Description</th>
                            <th class="p-3">Admin</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody" class="divide-y divide-slate-100">
                        <!-- Data -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<script src="../js/pages/admin-coin.js"></script>
</AdminLayout>
