---
import Layout from '../layouts/Layout.astro';
import '../styles/admin-professional.css';
---

<Layout title="Manage Duels - JDK Admin" description="Menghubungkan masa lalu dan masa kini melalui PopCulture, komunitas, retro arcade, dan marketplace vintage." hideNav={true} hideFooter={true}>
    <main class="ml-0 md:ml-64 transition-all duration-300 min-h-screen">

        <!-- Header -->
        <header
            class="bg-white border-b border-slate-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-slate-800">Manage Duels</h1>
                <p class="text-sm text-slate-500">Duel Economy & Live Monitoring</p>
            </div>
        </header>

        <div class="p-6 max-w-7xl mx-auto space-y-8">

            <!-- Grant Items Tool -->
            <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
                <div class="flex items-center gap-3 mb-6">
                    <span class="material-symbols-outlined text-amber-500 text-2xl">card_giftcard</span>
                    <h2 class="text-lg font-bold text-slate-800 uppercase tracking-tighter">Grant Items to User</h2>
                </div>

                <div class="grid md:grid-cols-3 gap-6 items-end">
                    <div class="md:col-span-1 space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Target
                            User</label>
                        <div class="relative">
                            <span
                                class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">person</span>
                            <input type="text" id="targetUser" class="input-field pl-10" placeholder="Search user...">
                        </div>
                    </div>
                    <div class="md:col-span-1 space-y-1.5">
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Select
                            Item</label>
                        <select id="itemKey" class="input-field">
                            <option value="mystery_box">🎁 Mystery Box</option>
                            <option value="powerup_shield">🛡️ Shield Power-Up</option>
                            <option value="powerup_double">💰 Double Reward</option>
                            <option value="powerup_vision">👁️ Vision Power-Up</option>
                        </select>
                    </div>
                    <div class="md:col-span-1 flex gap-3 items-end">
                        <div class="w-24 space-y-1.5">
                            <label
                                class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Qty</label>
                            <input type="number" id="itemQty" class="input-field text-center" value="1" min="1">
                        </div>
                        <button onclick="handleGrantItem()"
                            class="flex-1 btn bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm flex items-center justify-center gap-2 h-[42px]">
                            <span class="material-symbols-outlined text-lg">send</span> Grant
                        </button>
                    </div>
                </div>
            </div>

            <!-- Monitoring Grid -->
            <div class="grid md:grid-cols-2 gap-8">

                <!-- Ongoing Duels -->
                <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm flex flex-col h-[500px]">
                    <div class="flex justify-between items-center mb-6">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-blue-500 text-2xl">swords</span>
                            <h2 class="text-lg font-bold text-slate-800 uppercase tracking-tighter">Ongoing Duels</h2>
                        </div>
                        <span id="activeDuelCount"
                            class="bg-red-500 text-white text-[10px] font-bold px-2 py-1 rounded-full shadow-sm">0
                            ACTIVE</span>
                    </div>

                    <div class="overflow-y-auto flex-1 border border-slate-100 rounded-lg">
                        <table class="w-full text-left">
                            <thead
                                class="bg-slate-50 border-b border-slate-100 sticky top-0 text-xs font-semibold text-slate-500 uppercase">
                                <tr>
                                    <th class="p-3">Battle</th>
                                    <th class="p-3">Mode</th>
                                    <th class="p-3 text-center">Score</th>
                                </tr>
                            </thead>
                            <tbody id="activeDuelsBody" class="divide-y divide-slate-100 text-sm">
                                <!-- Dynamic -->
                            </tbody>
                        </table>
                        <div id="activeDuelsList"></div>
                        <!-- preserved for ID reference if needed by JS, though mostly table used -->
                    </div>
                </div>

                <!-- Recent Logs -->
                <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm flex flex-col h-[500px]">
                    <div class="flex items-center gap-3 mb-6">
                        <span class="material-symbols-outlined text-slate-500 text-2xl">history</span>
                        <h2 class="text-lg font-bold text-slate-800 uppercase tracking-tighter">Recent Duel Logs</h2>
                    </div>

                    <div class="overflow-y-auto flex-1 border border-slate-100 rounded-lg">
                        <table class="w-full text-left">
                            <thead
                                class="bg-slate-50 border-b border-slate-100 sticky top-0 text-xs font-semibold text-slate-500 uppercase">
                                <tr>
                                    <th class="p-3">Winner</th>
                                    <th class="p-3">Earnings</th>
                                    <th class="p-3">Time</th>
                                </tr>
                            </thead>
                            <tbody id="recentDuelsBody" class="divide-y divide-slate-100 text-sm">
                                <!-- Dynamic -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </div>
    </main>


<script src="../js/pages/admin-duels.js"></script>
</Layout>
