---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Manage Games - JDK Admin">
    <main class="ml-0 md:ml-64 transition-all duration-300 min-h-screen">

        <!-- Header -->
        <header
            class="bg-white border-b border-slate-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-slate-800">Manage Games</h1>
                <p class="text-sm text-slate-500">Game config, points, and rewards</p>
            </div>
            <button onclick="openGameModal()"
                class="btn bg-blue-600 hover:bg-blue-700 text-white shadow-sm flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">add_circle</span> Add Game
            </button>
        </header>

        <div class="p-6 max-w-7xl mx-auto">

            <!-- Games List -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex justify-between items-center">
                    <h2 class="font-bold text-slate-700">All Games</h2>
                    <!-- Placeholder for potential search/filters -->
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead
                            class="bg-slate-50 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase">
                            <tr>
                                <th class="p-4">Image</th>
                                <th class="p-4">Game Name</th>
                                <th class="p-4">Creator</th>
                                <th class="p-4">Category</th>
                                <th class="p-4">Points</th>
                                <th class="p-4">XP</th>
                                <th class="p-4 text-amber-600">Cost</th>
                                <th class="p-4">Access</th>
                                <th class="p-4 text-center">Plays</th>
                                <th class="p-4 text-center">Players</th>
                                <th class="p-4">Status</th>
                                <th class="p-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="gamesTableBody" class="divide-y divide-slate-100 text-sm">
                            <tr>
                                <td colspan="12" class="p-8 text-center text-slate-500">
                                    <div class="flex flex-col items-center">
                                        <span
                                            class="material-symbols-outlined text-4xl text-slate-300 mb-2 animate-spin">refresh</span>
                                        <p>Loading games...</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>




    <!-- Restored Modals -->
    <!-- Add/Edit Game Modal -->
    <div id="gameModal"
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
        <div
            class="bg-white rounded-xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col transform scale-95 transition-transform duration-200">
            <div class="flex items-center justify-between p-4 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-800" id="modalTitle">New Game</h3>
                <button onclick="closeGameModal()"
                    class="text-slate-400 hover:text-slate-600 p-1 rounded-full hover:bg-slate-100 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="p-6 overflow-y-auto">
                <form onsubmit="event.preventDefault(); saveGame();" class="space-y-5">
                    <input type="hidden" id="gameId">

                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Game
                            Name</label>
                        <input type="text" id="gameName" class="input-field" placeholder="e.g. JDK Jumper" required>
                    </div>

                    <div>
                        <label
                            class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Description</label>
                        <textarea id="gameDescription" class="input-field" rows="2"
                            placeholder="Short description..."></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label
                                class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Creator</label>
                            <input type="text" id="gameCreator" class="input-field" placeholder="JDK Team">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Category</label>
                            <input type="text" id="gameCategory" class="input-field" placeholder="Arcade / Puzzle">
                        </div>
                    </div>

                    <div class="grid grid-cols-4 gap-3">
                        <div>
                            <label
                                class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">PTS</label>
                            <input type="number" id="gamePoints" class="input-field" value="10">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">XP</label>
                            <input type="number" id="gameXp" class="input-field" value="10">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-semibold text-amber-600 uppercase tracking-wider mb-1.5">Coin</label>
                            <input type="number" id="gameCoinCost"
                                class="input-field border-amber-100 focus:border-amber-500" value="0">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Lvl</label>
                            <select id="gameMinLevel" class="input-field text-xs">
                                <option value="0">All</option>
                                <option value="1">Lvl 1</option>
                                <option value="5">Lvl 5</option>
                                <option value="10">Lvl 10</option>
                                <option value="20">Lvl 20</option>
                                <option value="50">Lvl 50</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Game
                            URL (Path)</label>
                        <input type="text" id="gameUrl" class="input-field" placeholder="e.g. jdk-jumper/dist/">
                    </div>

                    <div>
                        <label
                            class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Screenshot</label>
                        <input type="file" id="gameImage" class="input-field p-2" accept="image/*">
                        <input type="hidden" id="gameImageUrl">
                        <div id="imagePreview" class="mt-3 hidden">
                            <img src="" class="w-full h-32 object-cover rounded-lg border border-slate-200">
                        </div>
                    </div>

                    <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-lg border border-slate-100">
                        <input type="checkbox" id="gameActive" class="w-5 h-5 accent-blue-600 rounded cursor-pointer"
                            checked>
                        <label for="gameActive" class="text-sm font-semibold text-slate-700 cursor-pointer">Active
                            Status</label>
                    </div>

                    <div class="pt-4 border-t border-slate-100 flex gap-3">
                        <button type="submit" class="flex-1 btn bg-blue-600 hover:bg-blue-700 text-white shadow-sm">Save
                            Game</button>
                        <button type="button" id="btnDeleteGame" onclick="handleDeleteFromModal()"
                            class="btn bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 hidden">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

<script src="../js/pages/admin-games.js"></script>
</AdminLayout>
