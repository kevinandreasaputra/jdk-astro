---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Inventori Toko - JDK Admin">
    <main class="ml-0 md:ml-64 transition-all duration-300 min-h-screen bg-slate-100 flex flex-col">
        <!-- Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-20 px-4 md:px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                    <span class="material-symbols-outlined text-blue-600">inventory_2</span>
                    Inventori & Stok Pokemaret
                </h1>
            </div>
            <!-- Action buttons -->
            <div class="flex flex-wrap gap-3 w-full sm:w-auto">
                <button id="openAcqModalBtn" class="flex-1 sm:flex-initial btn bg-blue-600 hover:bg-blue-700 text-white text-xs md:text-sm py-2.5 px-3 md:px-4 shadow-sm flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span> Restock / Buyback
                </button>
                <button id="openProductModalBtn" class="flex-1 sm:flex-initial btn bg-slate-800 hover:bg-slate-900 text-white text-xs md:text-sm py-2.5 px-3 md:px-4 shadow-sm flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">post_add</span> Tambah Katalog
                </button>
            </div>
        </header>

        <!-- Main Body -->
        <div class="flex-1 p-6 max-w-7xl mx-auto w-full space-y-6">
            
            <!-- Summary Stats -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Nilai Aset Stok (HPP)</p>
                        <h3 id="totalAssetCost" class="text-2xl font-bold text-slate-800 mt-1">Rp 0</h3>
                    </div>
                    <span class="material-symbols-outlined text-blue-600 bg-blue-50 p-3 rounded-xl">account_balance_wallet</span>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Item Unik</p>
                        <h3 id="totalUniqueItems" class="text-2xl font-bold text-slate-800 mt-1">0</h3>
                    </div>
                    <span class="material-symbols-outlined text-indigo-600 bg-indigo-50 p-3 rounded-xl">widgets</span>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Stok Menipis (&lt; 5)</p>
                        <h3 id="lowStockCount" class="text-2xl font-bold text-slate-800 mt-1">0</h3>
                    </div>
                    <span class="material-symbols-outlined text-amber-600 bg-amber-50 p-3 rounded-xl">warning</span>
                </div>
            </div>

            <!-- View Tabs -->
            <div class="flex gap-2 mb-4">
                <button id="tabLotsBtn" class="px-4 py-2 text-xs font-bold rounded-lg bg-slate-800 text-white shadow-sm border border-slate-800 transition-colors cursor-pointer flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">layers</span> Stok Aktif
                </button>
                <button id="tabCatalogBtn" class="px-4 py-2 text-xs font-bold rounded-lg bg-white text-slate-600 hover:bg-slate-50 border border-slate-200 transition-colors cursor-pointer flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">database</span> Katalog Master
                </button>
            </div>

            <!-- Inventory Lots Table / List -->
            <div id="lotsTableContainer" class="bg-white rounded-xl border border-slate-200 shadow-sm">
                <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <h3 class="font-bold text-slate-800 text-sm">Pelacakan Lapisan Stok Aktif (Lots)</h3>
                    <div class="relative w-full sm:w-64">
                        <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-[18px]">search</span>
                        <input type="text" id="inventorySearch" placeholder="Cari barang..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-4 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-left text-xs">
                        <thead class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider border-b border-slate-100">
                            <tr>
                                <th class="p-4">Produk</th>
                                <th class="p-4">Kategori</th>
                                <th class="p-4">Tipe Kepemilikan</th>
                                <th class="p-4">Kondisi</th>
                                <th class="p-4">Sisa Stok / Awal</th>
                                <th class="p-4">Cost (HPP)</th>
                                <th class="p-4">Harga Jual</th>
                                <th class="p-4">Tanggal Masuk</th>
                            </tr>
                        </thead>
                        <tbody id="inventoryTableBody" class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td colspan="8" class="text-center p-8 text-slate-400">Loading inventory data...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Catalog Master Table / List (Hidden by default) -->
            <div id="catalogTableContainer" class="bg-white rounded-xl border border-slate-200 shadow-sm hidden">
                <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <h3 class="font-bold text-slate-800 text-sm">Daftar Katalog Master Produk (pm_products)</h3>
                    <div class="relative w-full sm:w-64">
                        <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-[18px]">search</span>
                        <input type="text" id="catalogSearch" placeholder="Cari katalog..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-4 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-left text-xs">
                        <thead class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider border-b border-slate-100">
                            <tr>
                                <th class="p-4">Produk</th>
                                <th class="p-4">Kategori</th>
                                <th class="p-4">Game TCG</th>
                                <th class="p-4">Rarity</th>
                                <th class="p-4">Barcode</th>
                                <th class="p-4 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="catalogTableBody" class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td colspan="6" class="text-center p-8 text-slate-400">Loading catalog data...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- MODAL 1: Restock / Buyback Form -->
        <div id="acqModal" class="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-3 sm:p-4 hidden">
            <div class="bg-white rounded-xl shadow-xl w-full max-w-lg max-h-[92vh] flex flex-col overflow-hidden border border-slate-200">
                <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50 shrink-0">
                    <h3 class="font-bold text-slate-800 text-sm">Catat Pembelian Baru / Buyback</h3>
                    <button class="close-modal-btn text-slate-400 hover:text-slate-600 cursor-pointer">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <form id="acqForm" class="p-6 space-y-4 overflow-y-auto flex-1 custom-scrollbar">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Tipe Transaksi</label>
                            <select id="acqType" class="w-full border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-blue-500">
                                <option value="SUPPLIER_PURCHASE">Pembelian Supplier</option>
                                <option value="CUSTOMER_BUYBACK">Customer Buyback (Beli Kartu Orang)</option>
                                <option value="CONSIGNMENT_INTAKE">Penerimaan Konsinyasi (Titip Jual)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Akun Pembayaran</label>
                            <select id="acqPaymentMethod" class="w-full border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-blue-500">
                                <option value="CASH">Kas Toko (Tunai)</option>
                                <option value="BCA_TRANSFER">Transfer BCA</option>
                            </select>
                        </div>
                    </div>

                    <!-- Customer search for buybacks -->
                    <div id="acqCustomerSection" class="hidden">
                        <label class="block text-xs font-bold text-slate-500 mb-1">Customer / Member Penjual</label>
                        <select id="acqCustomerSelect" class="w-full border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-blue-500">
                            <!-- Loaded Dynamically -->
                        </select>
                    </div>

                    <div class="border-t border-slate-100 pt-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <h4 class="text-xs font-bold text-slate-800">Item yang Masuk</h4>
                            <div class="flex items-center gap-2">
                                <button type="button" id="acqOcrToggleBtn" class="flex items-center gap-1 px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-lg text-[10px] font-bold border border-indigo-200 transition-colors cursor-pointer">
                                    <span class="material-symbols-outlined text-[13px]">photo_camera</span> Scan Kamera AI
                                </button>
                                <button type="button" id="acqAddItemBtn" class="flex items-center gap-1 px-2.5 py-1 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg text-[10px] font-bold border border-blue-200 transition-colors cursor-pointer">
                                    <span class="material-symbols-outlined text-[13px]">add</span> Tambah Item
                                </button>
                            </div>
                        </div>

                        <!-- Collapsible Camera Scanner for Buyback (Continuous/Batch) -->
                        <div id="acqOcrSection" class="hidden border border-slate-200 rounded-xl overflow-hidden bg-slate-950 p-2.5 space-y-2.5">
                            <div class="relative w-full aspect-[3/4] max-h-72 sm:max-h-80 bg-slate-900 rounded-lg overflow-hidden flex items-center justify-center">
                                <video id="acqOcrVideo" autoplay playsinline class="w-full h-full object-cover"></video>
                                
                                <!-- Clean Framing Guide -->
                                <div class="absolute inset-3 pointer-events-none border border-white/20 rounded-lg flex flex-col justify-between p-2">
                                    <div class="flex justify-between">
                                        <div class="w-5 h-5 border-t-2 border-l-2 border-indigo-400"></div>
                                        <div class="w-5 h-5 border-t-2 border-r-2 border-indigo-400"></div>
                                    </div>
                                    <div class="text-center">
                                        <span class="bg-slate-900/80 text-white/90 text-[10px] font-semibold px-2.5 py-1 rounded-full border border-white/10 tracking-wide backdrop-blur-xs">
                                            Arahkan kartu & tekan Jepret
                                        </span>
                                    </div>
                                    <div class="flex justify-between">
                                        <div class="w-5 h-5 border-b-2 border-l-2 border-indigo-400"></div>
                                        <div class="w-5 h-5 border-b-2 border-r-2 border-indigo-400"></div>
                                    </div>
                                </div>
                                
                                <!-- Flash Shutter Effect -->
                                <div id="acqOcrShutterFlash" class="absolute inset-0 bg-white opacity-0 transition-opacity duration-150 pointer-events-none"></div>
                                
                                <!-- Floating Toast Banner for Feedback -->
                                <div id="acqOcrToast" class="absolute top-3 left-3 right-3 hidden transform transition-all duration-300 flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold shadow-lg border border-emerald-400/30 bg-emerald-950/90 text-emerald-300 backdrop-blur-sm z-20">
                                    <span class="material-symbols-outlined text-[18px] text-emerald-400">check_circle</span>
                                    <span id="acqOcrToastMsg" class="truncate flex-1">Kartu Berhasil Ditambahkan!</span>
                                </div>

                                <!-- Spinner overlay -->
                                <div id="acqOcrSpinner" class="absolute inset-0 bg-slate-950/80 flex flex-col items-center justify-center text-white text-[11px] hidden z-20">
                                    <span class="animate-spin material-symbols-outlined text-[28px] mb-1.5 text-indigo-400">sync</span>
                                    <span class="font-bold tracking-wider">SEDANG MEMBACA KARTU...</span>
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-2">
                                <button type="button" id="acqCaptureBtn" class="flex-1 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-lg shadow-sm flex items-center justify-center gap-1.5 cursor-pointer transition-colors">
                                    <span class="material-symbols-outlined text-[16px]">photo_camera</span> Pindai & Masukkan Keranjang
                                </button>
                                <button type="button" id="acqCancelScanBtn" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs rounded-lg cursor-pointer transition-colors">
                                    Tutup
                                </button>
                            </div>
                        </div>

                        <!-- Item Input Row (single, reused for adding) -->
                        <div id="acqItemInputRow" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end bg-slate-50 rounded-lg p-3 border border-slate-200">
                            <div class="col-span-1 md:col-span-6 relative flex items-start gap-2">
                                <div id="acqProductPreviewContainer" class="w-8 h-12 bg-slate-50 border border-dashed border-slate-200 rounded shrink-0 flex items-center justify-center text-slate-400 hidden select-none mt-4">
                                    <span class="material-symbols-outlined text-[16px]">image</span>
                                </div>
                                <img id="acqProductPreviewImg" class="w-8 h-12 object-cover rounded shadow border border-slate-100 shrink-0 hidden mt-4" />
                                <div class="flex-1 min-w-0">
                                    <label class="block text-[10px] font-bold text-slate-500 mb-1">Nama Produk / Kartu</label>
                                    <input type="hidden" id="acqProductSelect" />
                                    <input type="text" id="acqProductSearch" placeholder="Ketik nama kartu / cari nomor..." class="w-full border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-blue-500" autocomplete="off" />
                                    <div id="acqProductSearchResults" class="absolute left-0 right-0 mt-1 bg-white border border-slate-200 rounded-lg shadow-lg z-30 max-h-48 overflow-y-auto hidden"></div>
                                </div>
                            </div>
                            <div class="col-span-1 md:col-span-2">
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Jumlah</label>
                                <input type="number" id="acqQty" value="1" min="1" class="w-full border border-slate-200 rounded-lg p-2 text-xs text-center" />
                            </div>
                            <div class="col-span-1 md:col-span-2">
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Kondisi</label>
                                <select id="acqCondition" class="w-full border border-slate-200 rounded-lg p-2 text-xs">
                                    <option value="NM">NM</option>
                                    <option value="LP">LP</option>
                                    <option value="MP">MP</option>
                                    <option value="HP">HP</option>
                                    <option value="DMG">DMG</option>
                                </select>
                            </div>
                            <div class="col-span-1 md:col-span-2">
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Tipe Kepemilikan</label>
                                <select id="acqOwnership" class="w-full border border-slate-200 rounded-lg p-2 text-xs">
                                    <option value="OWNED">Milik Toko</option>
                                    <option value="CONSIGNMENT">Titip Jual</option>
                                </select>
                            </div>
                        </div>

                        <!-- Consignment Section -->
                        <div id="consignSection" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4 bg-slate-50 border border-slate-200 p-3 rounded-lg">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Pemilik Barang (Consignor)</label>
                                <select id="consignOwnerSelect" class="w-full border border-slate-200 rounded-lg p-2 text-xs">
                                    <!-- Dynamic profiles list -->
                                </select>
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Bagi Hasil Toko (%)</label>
                                <input type="number" id="consignFee" value="15" min="0" max="100" class="w-full border border-slate-200 rounded-lg p-2 text-xs" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <label class="block text-xs font-bold text-slate-500">Harga Beli Satuan (Cost HPP)</label>
                                    <a id="acqManualCardtellBtn" href="https://cardtell.id" target="_blank" class="hidden inline-flex items-center gap-1 text-[10px] font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 px-2 py-0.5 rounded transition-colors cursor-pointer" title="Cek harga pasar di Cardtell.id">
                                        <span class="material-symbols-outlined text-[11px]">open_in_new</span> Cek Harga
                                    </a>
                                </div>
                                <input type="number" id="acqUnitCost" placeholder="Rp 0" class="w-full border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-blue-500" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-500 mb-1">Harga Jual Satuan</label>
                                <input type="number" id="acqSellingPrice" placeholder="Rp 0" class="w-full border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-blue-500" />
                            </div>
                        </div>

                        <!-- Cart: Added items list -->
                        <div id="acqItemsCart" class="hidden space-y-2">
                            <div class="flex items-center justify-between">
                                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Daftar Item Keranjang (<span id="acqCartCount">0</span>)</p>
                                <button type="button" id="acqClearCartBtn" class="text-[10px] font-bold text-red-500 hover:text-red-700 flex items-center gap-0.5 cursor-pointer">
                                    <span class="material-symbols-outlined text-[12px]">delete_sweep</span> Hapus Semua
                                </button>
                            </div>
                            <div id="acqCartBody" class="bg-slate-50 rounded-lg border border-slate-200 divide-y divide-slate-200 max-h-56 overflow-y-auto">
                            </div>
                            <!-- Payout Summary -->
                            <div class="bg-blue-50/70 border border-blue-200 rounded-lg p-2.5 flex items-center justify-between text-xs">
                                <div>
                                    <span class="text-[10px] font-bold text-slate-500 uppercase">Total Kas Keluar (Bayar ke Penjual):</span>
                                    <p id="acqCartTotalPayout" class="font-bold text-blue-700 text-sm">Rp 0</p>
                                </div>
                                <div class="text-right">
                                    <span class="text-[10px] font-bold text-slate-500 uppercase">Total Nilai Jual:</span>
                                    <p id="acqCartTotalSelling" class="font-semibold text-slate-600">Rp 0</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" id="acqFormSubmitBtn" class="w-full btn bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 text-xs shadow-md mt-4 flex items-center justify-center gap-2 cursor-pointer transition-all">
                        <span class="material-symbols-outlined text-[16px]">save</span> Simpan & Masukkan ke Stok
                    </button>
                </form>
            </div>
        </div>

        <!-- MODAL 2: Create New Product Catalog -->
        <div id="productModal" class="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-3 sm:p-4 hidden">
            <div class="bg-white rounded-xl shadow-xl w-full max-w-md max-h-[92vh] flex flex-col overflow-hidden border border-slate-200">
                <div class="px-5 py-3.5 border-b border-slate-100 flex justify-between items-center bg-slate-50 shrink-0">
                    <h3 class="font-bold text-slate-800 text-sm">Tambah Katalog Produk</h3>
                    <button class="close-modal-btn text-slate-400 hover:text-slate-600 cursor-pointer">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <form id="productForm" class="p-5 space-y-3.5 overflow-y-auto flex-1 custom-scrollbar">
                    <!-- Collapsible Camera Scanner for Catalog -->
                    <div id="catalogOcrSection" class="hidden border border-slate-200 rounded-xl overflow-hidden bg-slate-950 p-2.5 space-y-2.5">
                        <div class="relative w-full aspect-[3/4] max-h-80 sm:max-h-96 bg-slate-900 rounded-lg overflow-hidden flex items-center justify-center">
                            <video id="catalogOcrVideo" autoplay playsinline class="w-full h-full object-cover"></video>
                            
                            <!-- Clean Framing Guide (Edge brackets matching card aspect) -->
                            <div class="absolute inset-3 pointer-events-none border border-white/20 rounded-lg flex flex-col justify-between p-2">
                                <div class="flex justify-between">
                                    <div class="w-5 h-5 border-t-2 border-l-2 border-blue-400"></div>
                                    <div class="w-5 h-5 border-t-2 border-r-2 border-blue-400"></div>
                                </div>
                                <div class="text-center">
                                    <span class="bg-slate-900/80 text-white/90 text-[10px] font-semibold px-2.5 py-1 rounded-full border border-white/10 tracking-wide backdrop-blur-xs">
                                        Posisikan kartu memenuhi layar
                                    </span>
                                </div>
                                <div class="flex justify-between">
                                    <div class="w-5 h-5 border-b-2 border-l-2 border-blue-400"></div>
                                    <div class="w-5 h-5 border-b-2 border-r-2 border-blue-400"></div>
                                </div>
                            </div>
                            
                            <!-- Flash Shutter Effect -->
                            <div id="catalogOcrShutterFlash" class="absolute inset-0 bg-white opacity-0 transition-opacity duration-150 pointer-events-none"></div>
                            
                            <!-- Spinner overlay -->
                            <div id="catalogOcrSpinner" class="absolute inset-0 bg-slate-950/80 flex flex-col items-center justify-center text-white text-[11px] hidden">
                                <span class="animate-spin material-symbols-outlined text-[28px] mb-1.5 text-blue-400">sync</span>
                                <span class="font-bold tracking-wider">SEDANG MEMPROSES AI...</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <button type="button" id="catalogCaptureBtn" class="flex-1 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-lg shadow-sm flex items-center justify-center gap-1.5 cursor-pointer transition-colors">
                                <span class="material-symbols-outlined text-[16px]">photo_camera</span> Pindai Kartu
                            </button>
                            <button type="button" id="catalogCancelScanBtn" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs rounded-lg cursor-pointer transition-colors">
                                Tutup
                            </button>
                        </div>
                    </div>

                    <!-- Button to toggle the scanner open -->
                    <button type="button" id="catalogOcrToggleBtn" class="w-full py-1.5 border border-dashed border-blue-300 bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold text-[10px] rounded-lg flex items-center justify-center gap-1 transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-[14px]">photo_camera</span> SCAN PRODUK / KARTU (AUTO-INPUT)
                    </button>

                    <!-- Scanned Card Preview -->
                    <div id="catalogOcrPreviewContainer" class="hidden flex flex-col items-center bg-slate-50 border border-slate-200 p-2 rounded-lg">
                        <span class="text-[9px] font-bold text-slate-400 mb-1 uppercase tracking-wider">Kartu Terdeteksi</span>
                        <img id="catalogOcrPreviewImg" class="w-20 h-28 object-cover rounded shadow border border-slate-300" />
                    </div>

                    <input type="hidden" id="prodImageUrl" />

                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block text-xs font-bold text-slate-500">Nama Produk / Kartu</label>
                            <a id="catalogCardtellBtn" href="https://cardtell.id" target="_blank" class="hidden inline-flex items-center gap-1 text-[10px] font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 px-2 py-0.5 rounded transition-colors cursor-pointer">
                                <span class="material-symbols-outlined text-[12px]">open_in_new</span> Cek Harga (Cardtell)
                            </a>
                        </div>
                        <input type="text" id="prodName" placeholder="e.g. Pikachu ex" class="w-full border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-blue-500" required />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Kategori</label>
                            <select id="prodCategory" class="w-full border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-blue-500">
                                <option value="SINGLES">Kartu Singles</option>
                                <option value="SEALED">Sealed Pack/Box</option>
                                <option value="ACCESSORIES">Aksesoris</option>
                                <option value="MYSTERY_PACK">Mystery Pack</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Game TCG</label>
                            <select id="prodGame" class="w-full border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-blue-500">
                                <option value="Pokemon">Pokemon TCG</option>
                                <option value="One Piece">One Piece Card Game</option>
                                <option value="Union Arena">Union Arena</option>
                                <option value="Other">Lainnya</option>
                            </select>
                        </div>
                    </div>
                    <div id="prodSinglesDetails" class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Kode Kartu</label>
                            <input type="text" id="prodCardNumber" placeholder="e.g. SV8a-125/125" class="w-full border border-slate-200 rounded-lg p-2 text-xs" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Rarity</label>
                            <input type="text" id="prodRarity" placeholder="e.g. SAR / UR" class="w-full border border-slate-200 rounded-lg p-2 text-xs" />
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Bahasa</label>
                            <select id="prodLanguage" class="w-full border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-blue-500">
                                <option value="ID">Indonesia (ID)</option>
                                <option value="EN">Inggris (EN)</option>
                                <option value="JP">Jepang (JP)</option>
                                <option value="CN">Mandarin (CN)</option>
                                <option value="TW">Mandarin (TW/HK)</option>
                                <option value="KR">Korea (KR)</option>
                                <option value="OTHER">Lainnya</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Barcode (Opsional)</label>
                            <input type="text" id="prodBarcode" placeholder="Scan or enter barcode" class="w-full border border-slate-200 rounded-lg p-2 text-xs" />
                        </div>
                    </div>

                    <!-- One-Stop Stock Intake Section (optional) -->
                    <div id="quickStockSection" class="border border-blue-100 bg-blue-50/50 rounded-lg p-3 space-y-3">
                        <div class="flex items-center justify-between">
                            <p class="text-xs font-bold text-blue-700 flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">inventory</span>
                                Langsung Input Stok (Opsional)
                            </p>
                            <label class="flex items-center gap-1.5 cursor-pointer">
                                <input type="checkbox" id="quickStockEnabled" class="w-3.5 h-3.5 rounded accent-blue-600" />
                                <span class="text-[10px] font-bold text-blue-600">Aktifkan</span>
                            </label>
                        </div>
                        <div id="quickStockFields" class="hidden space-y-3">
                            <div class="grid grid-cols-3 gap-2">
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-500 mb-1">Tipe</label>
                                    <select id="quickStockType" class="w-full border border-slate-200 rounded-lg p-2 text-[11px] focus:ring-2 focus:ring-blue-500">
                                        <option value="SUPPLIER_PURCHASE">Supplier</option>
                                        <option value="CUSTOMER_BUYBACK">Buyback</option>
                                        <option value="CONSIGNMENT_INTAKE">Titip Jual</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-500 mb-1">Jumlah</label>
                                    <input type="number" id="quickStockQty" value="1" min="1" class="w-full border border-slate-200 rounded-lg p-2 text-[11px] text-center" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-500 mb-1">Kondisi</label>
                                    <select id="quickStockCondition" class="w-full border border-slate-200 rounded-lg p-2 text-[11px]">
                                        <option value="NM">NM</option>
                                        <option value="LP">LP</option>
                                        <option value="MP">MP</option>
                                        <option value="HP">HP</option>
                                        <option value="DMG">DMG</option>
                                    </select>
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-500 mb-1">Harga Beli / HPP (Rp)</label>
                                    <input type="number" id="quickStockCost" placeholder="0" min="0" class="w-full border border-slate-200 rounded-lg p-2 text-[11px]" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-500 mb-1">Harga Jual (Rp)</label>
                                    <input type="number" id="quickStockPrice" placeholder="0" min="0" class="w-full border border-slate-200 rounded-lg p-2 text-[11px]" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Pembayaran</label>
                                <select id="quickStockPayment" class="w-full border border-slate-200 rounded-lg p-2 text-[11px]">
                                    <option value="CASH">Kas Toko (Tunai)</option>
                                    <option value="BCA_TRANSFER">Transfer BCA</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <button type="submit" id="productFormSubmitBtn" class="w-full btn bg-slate-800 hover:bg-slate-900 text-white font-bold py-2.5 text-xs shadow-md mt-4 flex items-center justify-center gap-2 cursor-pointer transition-all">
                        <span class="material-symbols-outlined text-[16px]">save</span> Simpan Katalog Produk
                    </button>
                </form>
            </div>
        </div>

        <!-- MODERN BOTTOM TOAST NOTIFICATION CONTAINER -->
        <div id="bottomToastContainer" class="fixed bottom-5 left-1/2 -translate-x-1/2 z-[9999] pointer-events-none flex flex-col items-center gap-2 w-full max-w-md px-4">
        </div>

        <!-- QUICK CONFIRM BOTTOM SHEET (Replaces window.confirm) -->
        <div id="quickConfirmSheet" class="fixed inset-0 bg-slate-900/60 z-[9998] flex items-end sm:items-center justify-center p-0 sm:p-4 hidden transition-opacity">
            <div class="bg-white rounded-t-2xl sm:rounded-2xl shadow-2xl w-full max-w-sm p-5 space-y-4 border border-slate-100 transform transition-transform animate-in slide-in-from-bottom duration-200">
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[22px]">inventory_2</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="font-bold text-slate-800 text-sm">Katalog Berhasil Disimpan!</h4>
                        <p class="text-xs text-slate-500 mt-1" id="quickConfirmSheetDesc">Mau langsung masukkan stok barang ini sekarang?</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 pt-1">
                    <button type="button" id="quickConfirmCancelBtn" class="flex-1 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-lg border border-slate-200 transition-colors cursor-pointer">
                        Nanti Saja
                    </button>
                    <button type="button" id="quickConfirmOkBtn" class="flex-1 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-colors cursor-pointer flex items-center justify-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">add</span> Input Stok
                    </button>
                </div>
            </div>
        </div>

    </main>

    <script src="../js/pages/admin-inventory.js"></script>
</AdminLayout>
