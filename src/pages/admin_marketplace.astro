---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Manage Marketplace - JDK Admin">
    <main class="ml-0 md:ml-64 transition-all duration-300 min-h-screen">

        <!-- Header -->
        <header
            class="bg-white border-b border-slate-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-slate-800">Marketplace</h1>
                <p class="text-sm text-slate-500">Review and manage community listings</p>
            </div>
            <!-- Potential Export/Add buttons could go here -->
        </header>

        <div class="p-6 max-w-7xl mx-auto">

            <!-- Filter Bar -->
            <div
                class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 mb-6 flex flex-col md:flex-row gap-4 justify-between items-center">
                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="filterStatus('pending')" id="btnFilterPending"
                        class="btn bg-amber-100 text-amber-700 hover:bg-amber-200 border-amber-200 shadow-none text-xs font-bold px-3 py-2 flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">hourglass_empty</span> PENDING
                    </button>
                    <button onclick="filterStatus('available')" id="btnFilterAvailable"
                        class="btn bg-white text-slate-600 hover:bg-slate-50 border-slate-200 shadow-none text-xs font-medium px-3 py-2 flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">check_circle</span> ACTIVE
                    </button>
                    <button onclick="filterStatus('sold')" id="btnFilterSold"
                        class="btn bg-white text-slate-600 hover:bg-slate-50 border-slate-200 shadow-none text-xs font-medium px-3 py-2 flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">monetization_on</span> SOLD
                    </button>
                    <button onclick="filterStatus('all')" id="btnFilterAll"
                        class="btn bg-white text-slate-600 hover:bg-slate-50 border-slate-200 shadow-none text-xs font-medium px-3 py-2">
                        ALL
                    </button>
                </div>

                <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto">
                    <select id="filterCategory" onchange="applyFilters()"
                        class="input-field text-xs py-2 h-9 min-w-[140px]">
                        <option value="all">Check Category...</option>
                        <option value="action-figures">Action Figures</option>
                        <option value="posters">Poster & Art</option>
                        <option value="games">Games & Console</option>
                        <option value="toys">Mainan Vintage</option>
                        <option value="comics">Komik & Buku</option>
                        <option value="stickers">Stickers</option>
                        <option value="collectibles">Koleksi</option>
                        <option value="other">Other</option>
                    </select>

                    <select id="filterType" onchange="applyFilters()"
                        class="input-field text-xs py-2 h-9 min-w-[120px]">
                        <option value="all">All Types</option>
                        <option value="idr">IDR (Sale)</option>
                        <option value="points">Points (Redeem)</option>
                    </select>
                </div>
            </div>

            <!-- Product List -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <!-- Desktop Table View -->
                <div class="hidden md:block overflow-x-auto">
                    <table class="w-full text-left bg-white">
                        <thead
                            class="bg-slate-50 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase">
                            <tr>
                                <th class="p-4">Status</th>
                                <th class="p-4">Type</th>
                                <th class="p-4 text-center">Image</th>
                                <th class="p-4">Item Name</th>
                                <th class="p-4">Seller</th>
                                <th class="p-4">Price / Points</th>
                                <th class="p-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="marketplaceTableBody" class="divide-y divide-slate-100 text-sm">
                            <!-- Dynamic -->
                            <tr>
                                <td colspan="7" class="p-8 text-center text-slate-500">
                                    <div class="flex flex-col items-center">
                                        <span
                                            class="material-symbols-outlined text-4xl text-slate-300 mb-2 animate-spin">refresh</span>
                                        <p>Loading items...</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div id="marketplaceCardView" class="md:hidden p-4 space-y-4 bg-slate-50 min-h-[200px]">
                    <!-- Dynamic -->
                </div>
            </div>

        </div>
    </main>




    <!-- Restored Modals -->
    <!-- Product Detail / Edit Modal -->
    <div id="productModal"
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
        <div
            class="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-hidden flex flex-col transform scale-95 transition-transform duration-200">
            <div class="flex items-center justify-between p-4 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-800" id="modalTitle">Review Product</h3>
                <button onclick="closeModal()"
                    class="text-slate-400 hover:text-slate-600 p-1 rounded-full hover:bg-slate-100 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-0">
                <div class="flex flex-col md:flex-row h-full">
                    <!-- Left: Images -->
                    <div class="w-full md:w-1/3 bg-slate-50 p-6 border-b md:border-b-0 md:border-r border-slate-200">
                        <div
                            class="aspect-square bg-white rounded-lg border border-slate-200 shadow-sm mb-4 flex items-center justify-center overflow-hidden">
                            <img id="modalPreview" src="" class="w-full h-full object-contain" alt="Preview">
                        </div>
                        <div id="adminGalleryThumbnails" class="grid grid-cols-4 gap-2">
                            <!-- Injected via JS -->
                        </div>

                        <!-- Seller Info -->
                        <div id="sellerInfo" class="mt-6 p-4 bg-white rounded-lg border border-slate-200 shadow-sm">
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Seller Info
                            </p>
                            <div id="sellerUsername" class="text-sm font-medium text-slate-700 space-y-1">...</div>
                        </div>
                    </div>

                    <!-- Right: Form -->
                    <div class="w-full md:w-2/3 p-6 space-y-6">
                        <input type="hidden" id="productId">

                        <!-- Alert Guide -->
                        <div id="stickerAdminGuide"
                            class="hidden bg-blue-50 border border-blue-100 rounded-lg p-3 flex gap-3 text-sm text-blue-800">
                            <span class="material-symbols-outlined text-blue-500">info</span>
                            <div>
                                <p class="font-bold mb-1 text-xs uppercase">Sticker Pack Listing</p>
                                <p>Sticker files are uploaded manually by Admin. Review content and contact seller via
                                    Mailbox/WA.</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="md:col-span-2">
                                <label
                                    class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Product
                                    Name</label>
                                <input type="text" id="productName" class="input-field font-medium">
                            </div>

                            <div>
                                <label
                                    class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Payment
                                    Type</label>
                                <select id="productIsRedeemable" onchange="toggleAdminPriceFields()"
                                    class="input-field text-sm">
                                    <option value="false">IDR (Sale)</option>
                                    <option value="true">Points (Redeem)</option>
                                </select>
                            </div>

                            <div id="adminPriceContainer">
                                <label
                                    class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Price
                                    (Rp)</label>
                                <input type="text" id="productPrice" class="input-field font-medium" inputmode="numeric"
                                    oninput="this.value=this.value.replace(/[^0-9]/g,'').replace(/\B(?=(\d{3})+(?!\d))/g,'.')">
                            </div>

                            <div id="adminPointsContainer" class="hidden">
                                <label
                                    class="block text-xs font-semibold text-blue-600 uppercase tracking-wider mb-1.5">Points
                                    Cost</label>
                                <input type="number" id="productRedeemPoints"
                                    class="input-field border-blue-100 text-blue-600 font-medium">
                            </div>

                            <div>
                                <label
                                    class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Condition</label>
                                <select id="productCondition" class="input-field text-sm">
                                    <option value="New">New</option>
                                    <option value="Like New">Like New</option>
                                    <option value="Good">Good</option>
                                    <option value="Fair">Fair</option>
                                    <option value="Anggap JUNK">Anggap JUNK</option>
                                </select>
                            </div>

                            <div>
                                <label
                                    class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Category</label>
                                <select id="productCategory" onchange="toggleStickerGuide()"
                                    class="input-field text-sm">
                                    <option value="action-figures">Action Figures</option>
                                    <option value="posters">Poster & Art</option>
                                    <option value="games">Games & Console</option>
                                    <option value="toys">Mainan Vintage</option>
                                    <option value="comics">Komik & Buku</option>
                                    <option value="stickers">Sticker Pack</option>
                                    <option value="collectibles">Koleksi</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>

                            <div class="md:col-span-2">
                                <label
                                    class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Sales
                                    Status</label>
                                <select id="productStatus" class="input-field text-sm font-semibold">
                                    <option value="pending" class="text-amber-600">PENDING (Review) ⏳</option>
                                    <option value="available" class="text-emerald-600">AVAILABLE (Active) ✅</option>
                                    <option value="sold" class="text-blue-600">SOLD (Out) 💰</option>
                                    <option value="rejected" class="text-rose-600">REJECTED 🚫</option>
                                </select>
                            </div>

                            <!-- Stock Management -->
                            <div class="md:col-span-2 bg-slate-50 p-4 rounded-lg border border-slate-200">
                                <div class="flex items-center justify-between mb-2">
                                    <label
                                        class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Stock
                                        Management</label>
                                    <div class="flex items-center gap-2">
                                        <input type="checkbox" id="productIsUnlimited"
                                            class="w-4 h-4 accent-blue-600 cursor-pointer"
                                            onchange="toggleStockInput()">
                                        <label for="productIsUnlimited"
                                            class="text-xs font-semibold text-slate-700 cursor-pointer">Unlimited
                                            Stock</label>
                                    </div>
                                </div>
                                <div class="relative">
                                    <span
                                        class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">inventory_2</span>
                                    <input type="number" id="productStock" min="0" placeholder="0"
                                        class="input-field pl-10">
                                </div>
                            </div>

                            <div class="md:col-span-2">
                                <label
                                    class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Description</label>
                                <textarea id="productDescription" class="input-field" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-white flex flex-col md:flex-row gap-3">
                <button id="btnApprove" onclick="approveProduct()"
                    class="flex-1 btn bg-emerald-500 hover:bg-emerald-600 text-white shadow-md font-bold py-3 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">check</span> Approve
                </button>
                <button id="btnReject" onclick="rejectProduct()"
                    class="flex-1 btn bg-rose-500 hover:bg-rose-600 text-white shadow-md font-bold py-3 flex items-center justify-center gap-2 hidden">
                    <span class="material-symbols-outlined">block</span> Reject
                </button>

                <div class="w-px bg-slate-200 mx-2 hidden md:block"></div>

                <button id="btnSave" onclick="saveProduct()"
                    class="flex-1 btn bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold py-3 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">save</span> Save Data
                </button>
                <button onclick="handleDelete()"
                    class="btn bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 p-3 flex items-center justify-center"
                    title="Delete Product">
                    <span class="material-symbols-outlined">delete</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Image Lightbox Overlay -->
    <div id="imageLightbox"
        class="fixed inset-0 z-[100] flex items-center justify-center bg-black/90 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200"
        onclick="if(event.target===this)closeLightbox()">
        <button onclick="closeLightbox()"
            class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors z-10 p-2 rounded-full hover:bg-white/10">
            <span class="material-symbols-outlined text-3xl">close</span>
        </button>
        <button id="lightboxPrev" onclick="event.stopPropagation();navigateLightbox(-1)"
            class="absolute left-4 text-white/70 hover:text-white transition-colors z-10 p-2 rounded-full hover:bg-white/10">
            <span class="material-symbols-outlined text-3xl">chevron_left</span>
        </button>
        <button id="lightboxNext" onclick="event.stopPropagation();navigateLightbox(1)"
            class="absolute right-4 text-white/70 hover:text-white transition-colors z-10 p-2 rounded-full hover:bg-white/10">
            <span class="material-symbols-outlined text-3xl">chevron_right</span>
        </button>
        <img id="lightboxImage" src=""
            class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl transform scale-95 transition-transform duration-200"
            alt="Zoom">
        <div id="lightboxCounter"
            class="absolute bottom-6 text-white/60 text-sm font-medium bg-black/40 px-3 py-1 rounded-full"></div>
    </div>

<script src="../js/pages/admin-marketplace.js"></script>
</AdminLayout>
