---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="POS Kasir Pokemaret - JDK Admin">
    <main class="ml-0 md:ml-64 transition-all duration-300 min-h-screen bg-slate-100 flex flex-col">
        <!-- Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                    <span class="material-symbols-outlined text-blue-600">point_of_sale</span>
                    POS Kasir Pokemaret
                </h1>
                <p class="text-sm text-slate-500">Pencatatan penjualan kasir toko fisik Pokemaret</p>
            </div>
            <!-- Connection Status -->
            <div id="connectionStatus" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                <span>Online / Database Terhubung</span>
            </div>
        </header>

        <!-- Mobile Tab Toggle (Visible only on mobile) -->
        <div class="flex lg:hidden bg-white border-b border-slate-200 sticky top-0 z-10 w-full shadow-sm">
            <button id="tabCatalogBtn" class="flex-1 py-3 text-center text-xs font-bold border-b-2 border-blue-600 text-blue-600 flex items-center justify-center gap-1.5 focus:outline-none transition-colors">
                <span class="material-symbols-outlined text-[18px]">grid_view</span>Katalog
            </button>
            <button id="tabCartBtn" class="flex-1 py-3 text-center text-xs font-bold border-b-2 border-transparent text-slate-500 flex items-center justify-center gap-1.5 focus:outline-none transition-colors">
                <span class="material-symbols-outlined text-[18px]">shopping_cart</span>Keranjang
                <span id="cartCountBadge" class="hidden bg-blue-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">0</span>
            </button>
        </div>

        <!-- Main Layout Split -->
        <div id="posMainContent" class="flex-1 p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-7xl mx-auto w-full pb-24 md:pb-6">
            
            <!-- LEFT COLUMN: Product Catalog (7 columns) -->
            <div id="catalogColumn" class="col-span-1 lg:col-span-7 flex flex-col space-y-6">
                <!-- Search and Barcode inputs -->
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-3">
                        <!-- Barcode Scanner -->
                        <div class="flex gap-2">
                            <div class="relative flex-1">
                                <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-[20px]">qr_code_scanner</span>
                                <input type="text" id="barcodeInput" placeholder="Scan Barcode / Barcode Input..." 
                                    class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                    autofocus />
                            </div>
                            <button id="toggleCameraBtn" type="button" class="px-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg flex items-center justify-center shadow-sm" title="Scan QR / Barcode">
                                <span class="material-symbols-outlined text-[20px]">qr_code_scanner</span>
                            </button>
                            <button id="toggleOcrCameraBtn" type="button" class="px-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg flex items-center justify-center shadow-sm" title="Scan Kartu (OCR)">
                                <span class="material-symbols-outlined text-[20px]">document_scanner</span>
                            </button>
                        </div>
                        <!-- Text Search -->
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-[20px]">search</span>
                            <input type="text" id="searchProductInput" placeholder="Cari nama produk / kode kartu..." 
                                class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>
                    </div>

                <!-- Camera Scanner Area (Hidden by default) -->
                <div id="cameraScannerArea" class="hidden bg-slate-900 p-4 rounded-xl border border-slate-700 shadow-xl relative overflow-hidden">
                    <div class="relative w-full bg-black rounded-lg overflow-hidden border border-slate-800 shadow-inner" style="min-height: 250px;">
                        <!-- QR Reader Div -->
                        <div id="qr-reader-pos" class="w-full h-full"></div>
                        
                        <!-- OCR Video Feed (Hidden by default) -->
                        <video id="ocrVideo" class="hidden w-full h-full object-cover" style="min-height: 250px;" playsinline autoplay></video>
                        
                        <!-- Camera Shutter Flash Effect Overlay -->
                        <div id="ocrCameraFlash" class="absolute inset-0 bg-white opacity-0 pointer-events-none transition-all duration-150 z-20"></div>

                        <!-- Processing Circular Spinner Overlay -->
                        <div id="ocrSpinnerContainer" class="hidden absolute inset-0 flex items-center justify-center bg-slate-950/40 z-10 pointer-events-none">
                            <div class="flex flex-col items-center gap-3">
                                <div class="w-10 h-10 border-4 border-indigo-500 border-t-transparent rounded-full animate-spin"></div>
                                <span class="text-[10px] text-white font-bold tracking-wide uppercase drop-shadow bg-slate-900/80 px-3 py-1.5 rounded-full border border-slate-700">SEDANG MEMPROSES...</span>
                            </div>
                        </div>
                        
                        <!-- Target Box Overlay for OCR -->
                        <div id="ocrOverlay" class="hidden absolute inset-0 flex flex-col items-center justify-between p-4 pointer-events-none">
                            <!-- Top Status Label -->
                            <div class="z-10 flex items-center gap-1.5 bg-slate-900/90 text-[10px] text-slate-300 font-bold px-3 py-1 rounded-full border border-slate-700 shadow backdrop-blur-sm">
                                <span id="ocrStatusDot" class="w-2 h-2 rounded-full bg-indigo-500 animate-ping"></span>
                                <span id="ocrStatusText">SIAP MEMINDAI</span>
                            </div>
                            
                            <!-- Scanner Frame Guide -->
                            <div class="relative flex items-center justify-center my-auto w-52 h-14">
                                <!-- Laser Line Animation (CSS) -->
                                <div id="ocrLaser" class="absolute left-0 right-0 h-[2px] bg-indigo-500 shadow-[0_0_8px_#6366f1] animate-[scan_2s_ease-in-out_infinite]" style="top: 0;"></div>
                                
                                <!-- Center Framing Box -->
                                <div class="border border-indigo-400/80 w-full h-full rounded-lg bg-transparent relative" style="box-shadow: 0 0 0 9999px rgba(15, 23, 42, 0.65);">
                                    <!-- L-Shaped Corners -->
                                    <div class="absolute -top-[2px] -left-[2px] w-4 h-4 border-t-2 border-l-2 border-indigo-500 rounded-tl-sm"></div>
                                    <div class="absolute -top-[2px] -right-[2px] w-4 h-4 border-t-2 border-r-2 border-indigo-500 rounded-tr-sm"></div>
                                    <div class="absolute -bottom-[2px] -left-[2px] w-4 h-4 border-b-2 border-l-2 border-indigo-500 rounded-bl-sm"></div>
                                    <div class="absolute -bottom-[2px] -right-[2px] w-4 h-4 border-b-2 border-r-2 border-indigo-500 rounded-br-sm"></div>
                                </div>
                            </div>
                            
                            <span class="z-10 text-[9px] text-slate-400 font-medium tracking-wide">PAS KAN KODE POJOK KARTU DI DALAM BINGKAI</span>
                        </div>

                        <!-- Inner Toast Banner (Floating overlay in video viewport) -->
                        <div id="ocrViewportToast" class="absolute top-3 left-3 right-3 hidden transform translate-y-[-20px] opacity-0 transition-all duration-300 flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold shadow-lg border">
                            <span id="ocrViewportToastIcon" class="material-symbols-outlined text-[16px]">check_circle</span>
                            <span id="ocrViewportToastMsg">Scan Berhasil!</span>
                        </div>
                    </div>
                    
                    <!-- Manual Capture Button for OCR (Hidden by default) -->
                    <div id="ocrActionContainer" class="hidden mt-3 flex flex-col gap-2 text-center">
                        <button id="triggerOcrBtn" type="button" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg text-xs shadow-md flex items-center justify-center gap-1.5 transition-all transform active:scale-95">
                            <span class="material-symbols-outlined text-[18px]">photo_camera</span>
                            <span id="triggerOcrBtnText">BACA KODE KARTU</span>
                        </button>
                        
                        <!-- Dev Seeder Button -->
                        <button id="seedDbBtn" type="button" class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-indigo-300 hover:text-white font-bold rounded-lg text-[10px] border border-slate-700 flex items-center justify-center gap-1.5 transition-all">
                            <span class="material-symbols-outlined text-[14px]">database</span>
                            <span>SEED KARTU DI DATABASE STAGING (PIKACHU, BRAMBLEGHAST)</span>
                        </button>
                    </div>

                    <button id="closeCameraBtn" type="button" class="absolute top-2 right-2 bg-slate-800 hover:bg-red-600 text-slate-400 hover:text-white rounded-full p-1.5 shadow border border-slate-700 transition-colors flex items-center justify-center">
                        <span class="material-symbols-outlined text-[16px]">close</span>
                    </button>
                </div>

                <style is:global>
                @keyframes scan {
                    0%, 100% {
                        top: 0%;
                    }
                    50% {
                        top: 100%;
                    }
                }
                </style>

                <!-- Product Filters -->
                <div class="flex gap-2 overflow-x-auto pb-1 max-w-full custom-scrollbar">
                    <button class="filter-tab active px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-800 text-white whitespace-nowrap" data-category="ALL">Semua</button>
                    <button class="filter-tab px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-55 whitespace-nowrap" data-category="SINGLES">Kartu Singles</button>
                    <button class="filter-tab px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-55 whitespace-nowrap" data-category="SEALED">Sealed Pack/Box</button>
                    <button class="filter-tab px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-55 whitespace-nowrap" data-category="ACCESSORIES">Aksesoris</button>
                    <button class="filter-tab px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-55 whitespace-nowrap" data-category="MYSTERY_PACK">Mystery Pack</button>
                </div>

                <!-- Product Grid -->
                <div id="productGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-4 overflow-y-auto max-h-[calc(100vh-270px)] pr-1 custom-scrollbar">
                    <!-- Dynamic Products Loading -->
                    <div class="col-span-full text-center p-12 text-slate-400">Loading catalog...</div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Cart and Checkout (5 columns) -->
            <div id="cartColumn" class="col-span-1 lg:col-span-5 flex flex-col space-y-6 hidden lg:flex">
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col h-full max-h-[calc(100vh-140px)]">
                    <!-- Customer / Member Selector -->
                    <div class="p-4 border-b border-slate-100 bg-slate-50/50 rounded-t-xl space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Customer / Member JDK</span>
                            <button id="clearCustomerBtn" class="text-xs text-red-500 hover:underline hidden">Hapus Member</button>
                        </div>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-[20px]">person_search</span>
                            <input type="text" id="memberSearch" placeholder="Cari nama member / JDK ID..." 
                                class="w-full bg-white border border-slate-200 rounded-lg pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <div id="memberSearchResults" class="absolute left-0 right-0 mt-1 bg-white border border-slate-200 rounded-lg shadow-lg z-30 max-h-48 overflow-y-auto hidden"></div>
                        </div>
                        <!-- Active Customer Badge -->
                        <div id="activeCustomerBadge" class="hidden items-center gap-3 bg-blue-50 border border-blue-100 p-3 rounded-lg">
                            <span class="material-symbols-outlined text-blue-600">account_circle</span>
                            <div class="flex-1">
                                <p id="custName" class="text-sm font-semibold text-slate-800">-</p>
                                <p id="custPoints" class="text-xs text-slate-500">Poin: 0 | Level: Member</p>
                            </div>
                        </div>
                    </div>

                    <!-- Cart Item List -->
                    <div class="flex-1 overflow-y-auto p-4 space-y-3 min-h-[200px] custom-scrollbar" id="cartList">
                        <!-- Empty Cart -->
                        <div class="flex flex-col items-center justify-center h-full text-slate-400 py-12">
                            <span class="material-symbols-outlined text-[48px] mb-2">shopping_cart</span>
                            <p class="text-sm font-medium">Keranjang belanja kosong</p>
                        </div>
                    </div>

                    <!-- Totals and Payment Box -->
                    <div class="p-4 border-t border-slate-100 bg-slate-50/50 rounded-b-xl space-y-4">
                        <div class="space-y-2">
                            <div class="flex justify-between text-sm text-slate-600">
                                <span>Subtotal</span>
                                <span id="cartSubtotal">Rp 0</span>
                            </div>
                            <div class="flex justify-between text-base font-bold text-slate-800 border-t border-slate-200/60 pt-2">
                                <span>Total</span>
                                <span id="cartTotal" class="text-blue-600 text-lg">Rp 0</span>
                            </div>
                        </div>

                        <!-- Payment Method -->
                        <div class="space-y-2">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Metode Pembayaran</label>
                            <div class="grid grid-cols-3 gap-2">
                                <button class="pay-method-btn active flex flex-col items-center p-2 rounded-lg border-2 border-blue-600 bg-blue-50/50 text-blue-700" data-method="CASH">
                                    <span class="material-symbols-outlined text-[20px]">payments</span>
                                    <span class="text-[10px] font-bold mt-1">TUNAI</span>
                                </button>
                                <button class="pay-method-btn flex flex-col items-center p-2 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600" data-method="QRIS">
                                    <span class="material-symbols-outlined text-[20px]">qr_code_2</span>
                                    <span class="text-[10px] font-bold mt-1">QRIS</span>
                                </button>
                                <button class="pay-method-btn flex flex-col items-center p-2 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600" data-method="BCA_TRANSFER">
                                    <span class="material-symbols-outlined text-[20px]">account_balance</span>
                                    <span class="text-[10px] font-bold mt-1">TRANSFER</span>
                                </button>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button id="checkoutBtn" class="w-full btn bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 shadow-md rounded-xl text-center flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">check_circle</span>
                            PROSES TRANSAKSI
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Success Modal / Receipt Preview -->
        <div id="receiptModal" class="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4 hidden">
            <div class="bg-white rounded-xl shadow-xl w-full max-w-sm overflow-hidden border border-slate-200">
                <div class="p-6 text-center border-b border-slate-100">
                    <span class="material-symbols-outlined text-[48px] text-emerald-500 bg-emerald-50 p-3 rounded-full mb-3">check_circle</span>
                    <h3 class="font-bold text-lg text-slate-800">Transaksi Berhasil!</h3>
                    <p class="text-xs text-slate-500 mt-1" id="receiptTime">-</p>
                </div>
                <div class="p-6 space-y-4 text-xs font-mono text-slate-700" id="receiptContent">
                    <!-- Dynamic Receipt Content -->
                </div>
                <div class="p-4 bg-slate-50 border-t border-slate-100 flex gap-3">
                    <button id="printReceiptBtn" class="flex-1 btn bg-slate-800 hover:bg-slate-900 text-white text-xs py-2 flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[16px]">print</span> Cetak Struk
                    </button>
                    <button id="closeReceiptBtn" class="flex-1 btn bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs py-2">
                        Tutup
                    </button>
                </div>
            </div>
        </div>
        <!-- Floating Mobile Cart Bar (Visible only on mobile and when catalog tab is active and cart has items) -->
        <div id="floatingCartBar" class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 p-4 flex items-center justify-between shadow-lg z-30 lg:hidden hidden">
            <div class="flex flex-col">
                <span id="floatingCartCount" class="text-xs text-slate-500 font-semibold">0 Item</span>
                <span id="floatingCartTotal" class="text-sm font-bold text-slate-800">Rp 0</span>
            </div>
            <button id="viewCartTabBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-4 py-2 rounded-lg flex items-center gap-1 shadow-md">
                Lihat Keranjang <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </button>
        </div>
    </main>

    <!-- Client-side javascript for core POS Logic -->
    <script src="../js/pages/admin-pos.js"></script>
</AdminLayout>
