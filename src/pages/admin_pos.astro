---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="POS Kasir Pokemaret - JDK Admin">
    <main class="ml-0 md:ml-64 transition-all duration-300 min-h-screen bg-slate-100 flex flex-col">
        <!-- Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                    <span class="material-symbols-outlined text-blue-600">point_of_sale</span>
                    POS Kasir Pokemaret
                </h1>
                <p class="text-sm text-slate-500">Pencatatan penjualan kasir toko fisik Jordan Toys / Pokemaret</p>
            </div>
            <!-- Connection Status -->
            <div id="connectionStatus" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                <span>Online / Database Terhubung</span>
            </div>
        </header>

        <!-- Main Layout Split -->
        <div class="flex-1 p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-7xl mx-auto w-full">
            
            <!-- LEFT COLUMN: Product Catalog (7 columns) -->
            <div class="lg:col-span-7 flex flex-col space-y-6">
                <!-- Search and Barcode inputs -->
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-3">
                        <!-- Barcode Scanner -->
                        <div class="flex gap-2">
                            <div class="relative flex-1">
                                <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-[20px]">qr_code_scanner</span>
                                <input type="text" id="barcodeInput" placeholder="Scan Barcode / Barcode Input..." 
                                    class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                    autofocus />
                            </div>
                            <button id="toggleCameraBtn" type="button" class="px-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg flex items-center justify-center shadow-sm" title="Scan menggunakan kamera HP">
                                <span class="material-symbols-outlined text-[20px]">photo_camera</span>
                            </button>
                        </div>
                        <!-- Text Search -->
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-[20px]">search</span>
                            <input type="text" id="searchProductInput" placeholder="Cari nama produk / kode kartu..." 
                                class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>
                    </div>

                <!-- Camera Scanner Area (Hidden by default) -->
                <div id="cameraScannerArea" class="hidden bg-white p-4 rounded-xl border border-slate-200 shadow-sm relative overflow-hidden">
                    <div id="qr-reader-pos" class="w-full bg-slate-100 rounded-lg overflow-hidden border border-slate-200 shadow-inner" style="min-height: 250px;"></div>
                    <button id="closeCameraBtn" type="button" class="absolute top-2 right-2 bg-red-500 hover:bg-red-600 text-white rounded-full p-1.5 shadow flex items-center justify-center">
                        <span class="material-symbols-outlined text-[16px]">close</span>
                    </button>
                </div>

                <!-- Product Filters -->
                <div class="flex gap-2 overflow-x-auto pb-1 max-w-full custom-scrollbar">
                    <button class="filter-tab active px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-800 text-white whitespace-nowrap" data-category="ALL">Semua</button>
                    <button class="filter-tab px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-55 whitespace-nowrap" data-category="SINGLES">Kartu Singles</button>
                    <button class="filter-tab px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-55 whitespace-nowrap" data-category="SEALED">Sealed Pack/Box</button>
                    <button class="filter-tab px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-55 whitespace-nowrap" data-category="ACCESSORIES">Aksesoris</button>
                    <button class="filter-tab px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:bg-slate-55 whitespace-nowrap" data-category="MYSTERY_PACK">Mystery Pack</button>
                </div>

                <!-- Product Grid -->
                <div id="productGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-4 overflow-y-auto max-h-[calc(100vh-270px)] pr-1 custom-scrollbar">
                    <!-- Dynamic Products Loading -->
                    <div class="col-span-full text-center p-12 text-slate-400">Loading catalog...</div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Cart and Checkout (5 columns) -->
            <div class="lg:col-span-5 flex flex-col space-y-6">
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col h-full max-h-[calc(100vh-140px)]">
                    <!-- Customer / Member Selector -->
                    <div class="p-4 border-b border-slate-100 bg-slate-50/50 rounded-t-xl space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Customer / Member JDK</span>
                            <button id="clearCustomerBtn" class="text-xs text-red-500 hover:underline hidden">Hapus Member</button>
                        </div>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-[20px]">person_search</span>
                            <input type="text" id="memberSearch" placeholder="Cari nama member / JDK ID..." 
                                class="w-full bg-white border border-slate-200 rounded-lg pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <div id="memberSearchResults" class="absolute left-0 right-0 mt-1 bg-white border border-slate-200 rounded-lg shadow-lg z-30 max-h-48 overflow-y-auto hidden"></div>
                        </div>
                        <!-- Active Customer Badge -->
                        <div id="activeCustomerBadge" class="hidden items-center gap-3 bg-blue-50 border border-blue-100 p-3 rounded-lg">
                            <span class="material-symbols-outlined text-blue-600">account_circle</span>
                            <div class="flex-1">
                                <p id="custName" class="text-sm font-semibold text-slate-800">-</p>
                                <p id="custPoints" class="text-xs text-slate-500">Poin: 0 | Level: Member</p>
                            </div>
                        </div>
                    </div>

                    <!-- Cart Item List -->
                    <div class="flex-1 overflow-y-auto p-4 space-y-3 min-h-[200px] custom-scrollbar" id="cartList">
                        <!-- Empty Cart -->
                        <div class="flex flex-col items-center justify-center h-full text-slate-400 py-12">
                            <span class="material-symbols-outlined text-[48px] mb-2">shopping_cart</span>
                            <p class="text-sm font-medium">Keranjang belanja kosong</p>
                        </div>
                    </div>

                    <!-- Totals and Payment Box -->
                    <div class="p-4 border-t border-slate-100 bg-slate-50/50 rounded-b-xl space-y-4">
                        <div class="space-y-2">
                            <div class="flex justify-between text-sm text-slate-600">
                                <span>Subtotal</span>
                                <span id="cartSubtotal">Rp 0</span>
                            </div>
                            <div class="flex justify-between text-base font-bold text-slate-800 border-t border-slate-200/60 pt-2">
                                <span>Total</span>
                                <span id="cartTotal" class="text-blue-600 text-lg">Rp 0</span>
                            </div>
                        </div>

                        <!-- Payment Method -->
                        <div class="space-y-2">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Metode Pembayaran</label>
                            <div class="grid grid-cols-3 gap-2">
                                <button class="pay-method-btn active flex flex-col items-center p-2 rounded-lg border-2 border-blue-600 bg-blue-50/50 text-blue-700" data-method="CASH">
                                    <span class="material-symbols-outlined text-[20px]">payments</span>
                                    <span class="text-[10px] font-bold mt-1">TUNAI</span>
                                </button>
                                <button class="pay-method-btn flex flex-col items-center p-2 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600" data-method="QRIS">
                                    <span class="material-symbols-outlined text-[20px]">qr_code_2</span>
                                    <span class="text-[10px] font-bold mt-1">QRIS</span>
                                </button>
                                <button class="pay-method-btn flex flex-col items-center p-2 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600" data-method="BCA_TRANSFER">
                                    <span class="material-symbols-outlined text-[20px]">account_balance</span>
                                    <span class="text-[10px] font-bold mt-1">TRANSFER</span>
                                </button>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button id="checkoutBtn" class="w-full btn bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 shadow-md rounded-xl text-center flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">check_circle</span>
                            PROSES TRANSAKSI
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Success Modal / Receipt Preview -->
        <div id="receiptModal" class="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4 hidden">
            <div class="bg-white rounded-xl shadow-xl w-full max-w-sm overflow-hidden border border-slate-200">
                <div class="p-6 text-center border-b border-slate-100">
                    <span class="material-symbols-outlined text-[48px] text-emerald-500 bg-emerald-50 p-3 rounded-full mb-3">check_circle</span>
                    <h3 class="font-bold text-lg text-slate-800">Transaksi Berhasil!</h3>
                    <p class="text-xs text-slate-500 mt-1" id="receiptTime">-</p>
                </div>
                <div class="p-6 space-y-4 text-xs font-mono text-slate-700" id="receiptContent">
                    <!-- Dynamic Receipt Content -->
                </div>
                <div class="p-4 bg-slate-50 border-t border-slate-100 flex gap-3">
                    <button id="printReceiptBtn" class="flex-1 btn bg-slate-800 hover:bg-slate-900 text-white text-xs py-2 flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[16px]">print</span> Cetak Struk
                    </button>
                    <button id="closeReceiptBtn" class="flex-1 btn bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs py-2">
                        Tutup
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Client-side javascript for core POS Logic -->
    <script src="../js/pages/admin-pos.js"></script>
</AdminLayout>
