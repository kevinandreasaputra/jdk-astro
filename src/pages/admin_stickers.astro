---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Manage Stickers - Admin Dashboard">
    <main class="ml-0 md:ml-64 transition-all duration-300 min-h-screen">

        <!-- Header -->
        <header
            class="bg-white border-b border-slate-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-slate-800">Manage Stickers</h1>
                <p class="text-sm text-slate-500">Stickers for mailbox and chat</p>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="window.openManagePacksModal()"
                    class="px-3 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-sm font-medium transition-colors shadow-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">inventory_2</span> Manage Packs
                </button>
                <button onclick="window.openAddStickerModal()"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">add_reaction</span> Add Sticker
                </button>
            </div>
        </header>

        <div class="p-6 max-w-7xl mx-auto space-y-6">

            <!-- Filters -->
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col md:flex-row gap-4">
                <div class="flex-1 relative">
                    <span
                        class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">search</span>
                    <input type="text" id="stickerSearch" oninput="window.handleFilterChange()"
                        placeholder="Search sticker name..."
                        class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none">
                </div>
                <div class="w-full md:w-64">
                    <select id="packFilter" onchange="window.handleFilterChange()"
                        class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:border-blue-500 outline-none">
                        <option value="all">All Packs</option>
                    </select>
                </div>
                <button onclick="window.clearFilters()"
                    class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-xs font-medium transition-colors">
                    Reset
                </button>
            </div>

            <!-- Sticker Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4" id="stickerGrid">
                <div class="col-span-full py-20 text-center flex flex-col items-center justify-center text-slate-400">
                    <span class="material-symbols-outlined text-4xl mb-2 animate-bounce">downloading</span>
                    <span class="text-sm font-medium">Loading stickers...</span>
                </div>
            </div>

        </div>
    </main>




    <!-- Restored Modals -->
    <!-- Add Sticker Modal -->
    <div id="addStickerModal"
        class="fixed inset-0 hidden items-center justify-center z-50 bg-slate-900/50 backdrop-blur-sm">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-xl overflow-hidden flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <h3 class="text-lg font-bold text-slate-800">Add Sticker</h3>
                <button onclick="window.closeAddStickerModal()"
                    class="text-slate-400 hover:text-slate-600 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Sticker Name</label>
                    <input type="text" id="stickerName" class="input-field" placeholder="e.g. Mascot Cool">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Sticker Pack</label>
                    <select id="stickerPackId" class="input-field">
                        <option value="">- Select Pack -</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Image URL / Upload</label>
                    <input type="text" id="stickerUrl" class="input-field mb-2" placeholder="https://...">

                    <div
                        class="border border-dashed border-slate-300 p-3 rounded-lg bg-slate-50 hover:bg-blue-50 transition-colors cursor-pointer relative text-center">
                        <input type="file" id="stickerFileInput" class="absolute inset-0 opacity-0 cursor-pointer"
                            accept="image/*" multiple>
                        <span class="flex items-center justify-center gap-2 text-xs font-bold text-slate-600">
                            <span class="material-symbols-outlined text-sm">cloud_upload</span> Bulk Upload
                        </span>
                    </div>
                </div>

                <div class="p-4 bg-slate-50 rounded-lg border border-slate-100 flex justify-center">
                    <div id="stickerPreview"
                        class="w-20 h-20 bg-white rounded border border-slate-200 flex items-center justify-center overflow-hidden">
                        <span class="text-[10px] text-slate-300">Preview</span>
                    </div>
                </div>
            </div>

            <div class="p-4 border-b border-slate-100 bg-slate-50">
                <button onclick="window.saveSticker()" class="btn btn-primary w-full shadow-sm">Save Sticker</button>
            </div>
        </div>
    </div>

    <!-- Manage Packs Modal -->
    <div id="managePacksModal"
        class="fixed inset-0 hidden items-center justify-center z-50 bg-slate-900/50 backdrop-blur-sm">
        <div class="bg-white w-full max-w-2xl rounded-2xl shadow-xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <h3 class="text-lg font-bold text-slate-800">Manage Sticker Packs</h3>
                <button onclick="window.closeManagePacksModal()"
                    class="text-slate-400 hover:text-slate-600 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-6 space-y-6">

                <!-- Add/Edit Form -->
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
                    <h3 id="packFormTitle" class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">
                        Create New Pack</h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div class="md:col-span-2">
                            <label class="block text-xs font-semibold text-slate-500 mb-1">Pack Name</label>
                            <input type="text" id="packName" class="input-field">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-500 mb-1">Price (Points)</label>
                            <input type="number" id="packPrice" class="input-field" placeholder="0 = Free" value="0">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-500 mb-1">Thumbnail URL</label>
                            <input type="text" id="packThumbnail" class="input-field">
                        </div>
                    </div>

                    <div class="flex items-center gap-4 mb-4">
                        <div
                            class="flex-1 relative border border-dashed border-slate-300 rounded-lg h-12 flex items-center justify-center bg-white cursor-pointer hover:border-blue-400">
                            <input type="file" id="packThumbnailFileInput"
                                class="absolute inset-0 opacity-0 cursor-pointer" accept="image/*">
                            <span class="text-xs text-slate-500">Click to Upload Thumbnail</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div id="packThumbnailPreview"
                                class="w-12 h-12 bg-white rounded border border-slate-200 flex items-center justify-center overflow-hidden shrink-0">
                                <span class="text-[9px] text-slate-300">Pre</span>
                            </div>
                        </div>
                    </div>

                    <textarea id="packDesc" class="input-field h-20 mb-3 text-xs"
                        placeholder="Pack Description"></textarea>

                    <button id="btnSavePack" onclick="window.savePack()"
                        class="w-full py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-sm font-medium transition-colors shadow-sm">
                        Create Pack
                    </button>
                    <button id="btnCancelPackEdit" onclick="window.cancelPackEdit()"
                        class="hidden w-full mt-2 text-xs text-slate-500 hover:text-slate-700 underline">
                        Cancel Edit
                    </button>
                </div>

                <!-- Packs List -->
                <div class="border border-slate-200 rounded-xl overflow-hidden">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-100 text-xs font-semibold text-slate-500 uppercase">
                            <tr>
                                <th class="p-3">Pack Name</th>
                                <th class="p-3 text-center">Items</th>
                                <th class="p-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="packTableBody" class="divide-y divide-slate-100 bg-white">
                            <!-- JS Injection -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Sticker Modal -->
    <div id="editStickerModal"
        class="fixed inset-0 hidden items-center justify-center z-[60] bg-slate-900/50 backdrop-blur-sm">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-xl overflow-hidden flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <h3 class="text-lg font-bold text-slate-800">Edit Sticker</h3>
                <button onclick="window.closeEditStickerModal()"
                    class="text-slate-400 hover:text-slate-600 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <input type="hidden" id="editStickerId">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Sticker Name</label>
                    <input type="text" id="editStickerName" class="input-field">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Sticker Pack</label>
                    <select id="editStickerPackId" class="input-field">
                        <option value="">- Select Pack -</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Image URL</label>
                    <input type="text" id="editStickerUrl" class="input-field">
                </div>
                <div class="flex justify-center p-4 bg-slate-50 rounded-lg border border-slate-100">
                    <img id="editStickerPreviewImg" src="" class="max-w-[100px] max-h-[100px] object-contain">
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50">
                <button onclick="window.updateSticker()" class="btn btn-primary w-full shadow-sm">Update
                    Sticker</button>
            </div>
        </div>
    </div>

<script src="../js/pages/admin-stickers.js"></script>
</AdminLayout>
