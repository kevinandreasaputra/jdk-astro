---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Manage Stickers - Admin Dashboard">
    <main class="ml-0 md:ml-64 transition-all duration-300 min-h-screen">

        <!-- Header -->
        <header
            class="bg-white border-b border-slate-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-slate-800">Manage Stickers</h1>
                <p class="text-sm text-slate-500">Stickers for mailbox and chat</p>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="window.openManagePacksModal()"
                    class="px-3 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-sm font-medium transition-colors shadow-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">inventory_2</span> Manage Packs
                </button>
                <button onclick="window.openAddStickerModal()"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">add_reaction</span> Add Sticker
                </button>
            </div>
        </header>

        <div class="p-6 max-w-7xl mx-auto space-y-6">

            <!-- Filters -->
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col md:flex-row gap-4">
                <div class="flex-1 relative">
                    <span
                        class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">search</span>
                    <input type="text" id="stickerSearch" oninput="window.handleFilterChange()"
                        placeholder="Search sticker name..."
                        class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none">
                </div>
                <div class="w-full md:w-64">
                    <select id="packFilter" onchange="window.handleFilterChange()"
                        class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:border-blue-500 outline-none">
                        <option value="all">All Packs</option>
                    </select>
                </div>
                <button onclick="window.clearFilters()"
                    class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-xs font-medium transition-colors">
                    Reset
                </button>
            </div>

            <!-- Sticker Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4" id="stickerGrid">
                <div class="col-span-full py-20 text-center flex flex-col items-center justify-center text-slate-400">
                    <span class="material-symbols-outlined text-4xl mb-2 animate-bounce">downloading</span>
                    <span class="text-sm font-medium">Loading stickers...</span>
                </div>
            </div>

        </div>
    </main>


<script src="../js/pages/admin-stickers.js"></script>
</AdminLayout>
