---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <!-- Page Title: Contact JDK Entertainment - Get in Touch -->
    <main>
        <!-- Hero Section -->
        <section class="relative overflow-hidden bg-primary min-h-[300px] flex items-center border-b-4 border-black">
            <!-- Retro Pattern Overlay -->
            <div class="absolute inset-0 opacity-10 pointer-events-none"
                style="background-image: radial-gradient(#000 1.5px, transparent 1.5px); background-size: 24px 24px;">
            </div>

            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10 w-full text-center">
                <h1
                    class="text-black text-5xl sm:text-7xl font-black leading-none tracking-tight uppercase drop-shadow-sm mb-4">
                    HUBUNGI <span class="text-white drop-shadow-[4px_4px_0px_#000]">KAMI</span>
                </h1>
                <p class="text-black/80 text-xl font-bold max-w-2xl mx-auto leading-relaxed">
                    Punya pertanyaan, kerjasama, atau kritik? Tim JDK Entertainment siap mendengar suara Anda.
                </p>
            </div>
        </section>

        <!-- Contact Content -->
        <section class="py-16 bg-background-light">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid md:grid-cols-2 gap-12">

                    <!-- Left Column: Info -->
                    <div class="space-y-8">
                        <div class="bg-white p-8 rounded-2xl border-2 border-black shadow-[8px_8px_0px_#000]">
                            <h3 class="text-2xl font-black uppercase text-black mb-6 flex items-center gap-2">
                                <span class="material-symbols-outlined text-3xl text-primary-dark">info</span>
                                Informasi Kontak
                            </h3>

                            <div class="space-y-6">
                                <div class="flex items-start gap-4">
                                    <div class="bg-yellow-100 p-3 rounded-xl border border-black/10">
                                        <span
                                            class="material-symbols-outlined text-yellow-600 text-2xl">location_on</span>
                                    </div>
                                    <div>
                                        <h4 class="font-black text-lg text-black uppercase">Alamat Markas</h4>
                                        <p class="text-gray-600 font-body font-medium leading-normal">
                                            Satu Tujuan Cafe<br>
                                            Jln North Sorrento no 17<br>
                                            Gading Serpong - Tangerang
                                        </p>
                                    </div>
                                </div>

                                <div class="flex items-start gap-4">
                                    <div class="bg-blue-100 p-3 rounded-xl border border-black/10">
                                        <span class="material-symbols-outlined text-blue-600 text-2xl">mail</span>
                                    </div>
                                    <div>
                                        <h4 class="font-black text-lg text-black uppercase">Email</h4>
                                        <p class="text-gray-600 font-body font-medium">admin&#64;jadulkekinian.com</p>
                                    </div>
                                </div>

                                <div class="flex items-start gap-4">
                                    <div class="bg-green-100 p-3 rounded-xl border border-black/10">
                                        <span class="material-symbols-outlined text-green-600 text-2xl">chat</span>
                                    </div>
                                    <div>
                                        <h4 class="font-black text-lg text-black uppercase">WhatsApp Group</h4>
                                        <a href="https://chat.whatsapp.com/HhqyCqifK5HD0iG0gzXsF6" target="_blank"
                                            class="text-primary-dark font-bold hover:underline font-body">
                                            Gabung Grup WhatsApp →
                                        </a>
                                        <div class="mt-3">
                                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://chat.whatsapp.com/HhqyCqifK5HD0iG0gzXsF6"
                                                class="w-32 h-32">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-8 pt-8 border-t border-black/10">
                                <h4 class="font-black text-lg text-black uppercase text-center mb-4">Social Media</h4>
                                <div class="flex justify-center gap-6">
                                    <a href="https://instagram.com/jadulkekinian" target="_blank"
                                        class="hover:scale-110 transition-transform text-center group">
                                        <div
                                            class="w-12 h-12 bg-pink-100 rounded-full flex items-center justify-center border-2 border-black mb-1 group-hover:bg-pink-200">
                                            <span class="font-bold">IG</span>
                                        </div>
                                    </a>
                                    <a href="https://youtube.com/@jadulkekinian" target="_blank"
                                        class="hover:scale-110 transition-transform text-center group">
                                        <div
                                            class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center border-2 border-black mb-1 group-hover:bg-red-200">
                                            <span class="font-bold">YT</span>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Map -->
                        <div
                            class="bg-white rounded-2xl border-2 border-black overflow-hidden h-64 shadow-[4px_4px_0px_#000]">
                            <iframe
                                src="https://www.google.com/maps?q=Satu+Tujuan+Cafe+Gading+Serpong+Tangerang&t=&z=15&ie=UTF8&iwloc=&output=embed"
                                width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                    </div>

                    <!-- Right Column: Form -->
                    <div>
                        <div class="bg-white p-8 rounded-2xl border-2 border-black shadow-[8px_8px_0px_#000]">
                            <h3 class="text-2xl font-black uppercase text-black mb-2">Kirim Pesan</h3>
                            <p class="text-gray-500 font-bold mb-8">Kami akan membalas secepat mungkin!</p>

                            <form onsubmit="event.preventDefault(); submitContactForm();" class="space-y-6">
                                <div>
                                    <label class="block text-black font-bold uppercase text-sm mb-2">Nama
                                        Lengkap</label>
                                    <input type="text" id="contactName"
                                        class="w-full bg-gray-50 border-2 border-black rounded-xl p-3 font-body font-bold focus:ring-2 focus:ring-primary focus:border-black transition-all"
                                        placeholder="Siapa nama kamu?">
                                </div>

                                <div>
                                    <label class="block text-black font-bold uppercase text-sm mb-2">Email</label>
                                    <input type="email" id="contactEmail"
                                        class="w-full bg-gray-50 border-2 border-black rounded-xl p-3 font-body font-bold focus:ring-2 focus:ring-primary focus:border-black transition-all"
                                        placeholder="email@kamu.com">
                                </div>

                                <div>
                                    <label class="block text-black font-bold uppercase text-sm mb-2">Subjek</label>
                                    <select id="contactSubject"
                                        class="w-full bg-gray-50 border-2 border-black rounded-xl p-3 font-body font-bold focus:ring-2 focus:ring-primary focus:border-black transition-all text-gray-700">
                                        <option>Pertanyaan Umum</option>
                                        <option>Kerjasama / Sponsor</option>
                                        <option>Laporan Masalah</option>
                                        <option>Lainnya</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-black font-bold uppercase text-sm mb-2">Pesan</label>
                                    <textarea id="contactMessage" rows="5"
                                        class="w-full bg-gray-50 border-2 border-black rounded-xl p-3 font-body font-bold focus:ring-2 focus:ring-primary focus:border-black transition-all"
                                        placeholder="Tulis pesanmu disini..."></textarea>
                                </div>

                                <button type="submit"
                                    class="w-full btn-primary py-4 text-lg shadow-hard hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]">
                                    🚀 KIRIM PESAN
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </main>

</Layout>
