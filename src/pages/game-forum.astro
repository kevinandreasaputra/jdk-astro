---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Game Forum - JDK Entertainment" description="Forum diskusi game JDK Entertainment - Sharing tips, strategi, dan ngobrol bareng sesama JDKwan.">
    <main class="flex-grow">
        <div class="max-w-4xl mx-auto px-4 py-8">
            <!-- Back Button -->
            <a href="/games"
                class="inline-flex items-center gap-2 text-black/60 hover:text-black font-bold mb-6 group">
                <span
                    class="material-symbols-outlined group-hover:-translate-x-1 transition-transform">arrow_back</span>
                Kembali ke Games
            </a>

            <!-- Game Header -->
            <div id="gameHeader" class="bg-white border-2 border-black rounded-3xl overflow-hidden shadow-comic mb-8">
                <div class="flex flex-col md:flex-row">
                    <div class="w-full md:w-64 h-48 md:h-auto bg-gray-900 flex-shrink-0">
                        <img id="gameImage" src="/images/comic-background.jpg" alt="Game"
                            class="w-full h-full object-cover">
                    </div>
                    <div class="p-6 flex-1">
                        <div class="flex items-start justify-between mb-3">
                            <span id="gameCategory"
                                class="bg-blue-50 text-blue-600 text-[10px] font-black px-3 py-1 rounded-full border border-blue-100 uppercase tracking-widest">ARCADE</span>
                            <a id="playGameBtn" href="#"
                                class="bg-comic-yellow hover:bg-comic-orange text-black font-black text-sm px-4 py-2 rounded-xl border-2 border-black shadow-comic-sm hover:-translate-y-0.5 transition-all flex items-center gap-2">
                                <span class="material-symbols-outlined text-lg">play_arrow</span>
                                MAIN
                            </a>
                        </div>
                        <h1 id="gameName"
                            class="text-3xl md:text-4xl font-black text-black uppercase tracking-tight mb-2">Loading...
                        </h1>
                        <p id="gameDescription" class="text-gray-600 font-medium text-sm mb-4 line-clamp-2">Loading game
                            description...</p>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="flex items-center gap-1 text-gray-500">
                                <span class="material-symbols-outlined text-lg">forum</span>
                                <span id="commentCount" class="font-bold">0</span>
                                <span class="text-gray-400">komentar</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Comment Input (Logged in only) -->
            <div id="commentInputSection"
                class="hidden bg-white border-2 border-black rounded-2xl p-4 mb-6 shadow-comic-sm">
                <div class="flex gap-3">
                    <img id="currentUserAvatar" src="/images/mr-jdk-mascot.png" alt="Avatar"
                        class="w-10 h-10 rounded-full border-2 border-black object-cover flex-shrink-0">
                    <div class="flex-1 relative">
                        <!-- Mention Suggestions Dropdown -->
                        <div id="mentionSuggestions"
                            class="hidden absolute bottom-full left-0 right-0 bg-white border-2 border-black rounded-xl shadow-xl mb-2 z-50 overflow-hidden">
                            <div
                                class="bg-primary text-black p-2 font-black text-xs uppercase tracking-wide border-b border-black">
                                MENTION JDKWAN
                            </div>
                            <div id="mentionList" class="max-h-48 overflow-y-auto"></div>
                        </div>
                        <textarea id="commentInput" rows="3"
                            class="w-full bg-gray-50 border border-black/10 rounded-xl p-3 font-medium text-sm focus:ring-2 focus:ring-primary focus:border-transparent resize-none"
                            placeholder="Tulis komentar atau tips tentang game ini... (ketik @ untuk mention)"></textarea>
                        <div class="flex justify-between items-center mt-2">
                            <span class="text-[10px] text-gray-400 font-medium">Ketik @ untuk mention user lain</span>
                            <button onclick="window.submitComment()"
                                class="bg-black text-primary px-6 py-2 rounded-xl font-black text-sm hover:bg-gray-800 transition-colors flex items-center gap-2">
                                <span class="material-symbols-outlined text-lg">send</span>
                                Kirim
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Login Prompt (For non-logged in users) -->
            <div id="loginPrompt"
                class="hidden bg-yellow-50 border-2 border-yellow-400 rounded-2xl p-6 mb-6 text-center">
                <span class="material-symbols-outlined text-4xl text-yellow-500 mb-2">lock</span>
                <p class="font-bold text-gray-700 mb-3">Login untuk ikut diskusi!</p>
                <button onclick="openLoginModal()"
                    class="bg-black text-primary px-6 py-2 rounded-xl font-black text-sm hover:bg-gray-800 transition-colors">
                    LOGIN
                </button>
            </div>

            <!-- Reply Box (Hidden, shown when replying) -->
            <div id="replyBox"
                class="hidden fixed bottom-0 left-0 right-0 bg-white border-t-4 border-black p-4 z-50 shadow-hard">
                <div class="max-w-4xl mx-auto">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold text-gray-500">Membalas <span id="replyToUsername"
                                class="text-primary">@user</span></span>
                        <button onclick="window.cancelReply()"
                            class="text-red-500 font-black text-xs hover:underline">BATAL</button>
                    </div>
                    <div class="flex gap-2">
                        <textarea id="replyInput" rows="2"
                            class="flex-1 bg-gray-50 border border-black/10 rounded-xl p-3 font-medium text-sm focus:ring-2 focus:ring-primary focus:border-transparent resize-none"
                            placeholder="Tulis balasan..."></textarea>
                        <button onclick="window.submitReply()"
                            class="bg-black text-primary px-4 py-2 rounded-xl font-black text-sm hover:bg-gray-800 transition-colors flex-shrink-0">
                            <span class="material-symbols-outlined">send</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Comments List -->
            <div id="commentsList" class="space-y-4">
                <!-- Loading State -->
                <div id="commentsLoading" class="text-center py-12">
                    <div class="animate-bounce text-4xl mb-4">💬</div>
                    <p class="font-bold text-gray-500">Memuat diskusi...</p>
                </div>

                <!-- Empty State -->
                <div id="commentsEmpty"
                    class="hidden text-center py-12 bg-white border-2 border-dashed border-black/20 rounded-2xl">
                    <span class="material-symbols-outlined text-6xl text-gray-300 mb-4">forum</span>
                    <p class="font-bold text-gray-500 mb-2">Belum ada diskusi</p>
                    <p class="text-sm text-gray-400">Jadilah yang pertama berkomentar!</p>
                </div>
            </div>
        </div>
    </main>


<script src="../js/pages/game-forum.js"></script>
</Layout>
