---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <!-- Page Title: Playing Game - JDK Entertainment -->
    
    <!-- Game Header -->
    <header class="game-header">
        <a href="/games" class="back-btn">
            <span>←</span> Kembali
        </a>
        <h1 class="game-title" id="gameTitle">Loading...</h1>
        <div class="game-rewards">
            <span class="reward-badge points" id="pointsReward">⭐ 0 PTS</span>
            <span class="reward-badge xp" id="xpReward">✨ 0 XP</span>
        </div>
    </header>

    <!-- Game Container -->
    <div class="game-container">
        <div class="loading-screen" id="loadingScreen">
            <div class="loading-spinner"></div>
            <p style="margin-top: 16px;">Memuat game...</p>
        </div>
        <div class="error-screen" id="errorScreen">
            <h2>⚠️ Game Tidak Ditemukan</h2>
            <p>Maaf, game ini tidak tersedia atau URL tidak valid.</p>
            <a href="/games" class="back-btn" style="margin-top: 20px;">← Kembali ke Daftar Game</a>
        </div>
        <iframe id="gameIframe" class="game-iframe" style="display: none;"></iframe>
    </div>

    <script type="module">
        import { sbClient } from '../js/core/supabase.js';
        import { initializeUserSession, getCurrentUser } from '../js/modules/user-session.js';

        // Get game ID from URL params
        const params = new URLSearchParams(window.location.search);
        const gameId = params.get('id');
        const gameUrl = params.get('url');

        // Global variables for session management
        let currentPlayLogId = null;
        let currentGameSession = null; // { id, startTime }

        async function loadGame() {
            console.log('Initializing Session...');
            // Initialize User Session
            await initializeUserSession();
            const currentUser = getCurrentUser();
            console.log(`User: ${currentUser?.username || 'NULL'} (ID: ${currentUser?.id || '?'})`);
            console.log('👤 Player Session Initialized:', currentUser?.username, 'Role:', currentUser?.user_level);

            if (!gameId && !gameUrl) {
                showError();
                return;
            }

            let targetUrl = gameUrl;
            let gameName = 'Game';
            let pointsReward = 0;
            let xpReward = 0;

            // If gameId provided, fetch from database
            if (gameId) {
                const { data: game, error } = await sbClient
                    .from('games')
                    .select('*')
                    .eq('id', gameId)
                    .single();

                if (error || !game) {
                    showError();
                    return;
                }

                targetUrl = game.game_url;
                gameName = game.name;
                pointsReward = game.points_reward || 0;
                xpReward = game.xp_reward || 0;

                // Store rewards in window for listener access
                window.gameRewards = { pointsReward, xpReward, gameName, gameId };

                document.title = `${gameName} - JDK Entertainment`;
                document.getElementById('gameTitle').textContent = gameName;
                document.getElementById('pointsReward').textContent = `⭐ ${pointsReward} PTS`;
                document.getElementById('xpReward').textContent = `✨ ${xpReward} XP`;

                // 🔒 SECURITY: Request game session for anti-cheat
                if (currentUser) {
                    await startGameSession(gameId);
                }
            } else {
                // Direct URL mode
                document.getElementById('gameTitle').textContent = 'External Game';
            }

            if (!targetUrl) {
                showError();
                return;
            }

            // Ensure URL is handled correctly
            // Remove 'public_html/' if user accidentally included it
            targetUrl = targetUrl.replace('public_html/', '');
            targetUrl = targetUrl.replace(/^\/+/, ''); // Remove leading slashes to prevent double slashes if base is set

            // If it's a relative path, we let browser handle it relative to current page (root)
            // But if it lacks http, we treat it as relative path. 
            if (!targetUrl.startsWith('http')) {
                // No modification needed, 'games/uler/index.html' works from root
                // Just ensuring no double slashes if user put /games...
            }

            // --- SECURE ADMIN ACCESS PASS-THROUGH ---
            let isAdmin = false;
            try {
                // Clear old state
                localStorage.removeItem('uler_admin_access');

                const { data: { user } } = await sbClient.auth.getUser();
                console.log('🕵️ Checking admin status for:', user?.email);

                if (user) {
                    const { data: profile, error: pError } = await sbClient
                        .from('profiles')
                        .select('user_level')
                        .eq('id', user.id)
                        .single();

                    if (pError) console.error('❌ Profile fetch error:', pError);

                    const role = profile?.user_level || 'Member';
                    console.log('👤 User Level Found:', role);

                    if (role.toLowerCase() === 'admin') {
                        isAdmin = true;
                        // Set LocalStorage for dual-channel reliability
                        localStorage.setItem('uler_admin_access', 'true');
                        console.log('🛡️ Admin detected! LocalStorage flag set.');
                    }
                }
            } catch (e) {
                console.warn('⚠️ Admin check failed:', e);
            }

            // Append isAdmin to URL
            const separator = targetUrl.includes('?') ? '&' : '?';
            const finalTargetUrl = targetUrl + separator + 'isAdmin=' + isAdmin;
            console.log('🎮 FINAL GAME URL:', finalTargetUrl);

            // Load iframe AFTER we have all the data
            const iframe = document.getElementById('gameIframe');
            iframe.src = finalTargetUrl;

            iframe.onload = () => {
                console.log('✅ Iframe loaded successfully');
                document.getElementById('loadingScreen').style.display = 'none';
                iframe.style.display = 'block';

                // Send initial settings to the iframe
                if (gameId) {
                    sbClient.from('games').select('config').eq('id', gameId).single()
                        .then(({ data }) => {
                            if (data && data.config) {
                                iframe.contentWindow.postMessage({
                                    type: 'INIT_SETTINGS',
                                    config: data.config
                                }, '*');
                                console.log('📤 Sent initial settings to game:', data.config);
                            }
                        });

                    // NEW: Check for active event availability (Restricted)
                    console.log('🔍 Checking Game Name:', gameName);
                    const lowerName = gameName.toLowerCase();
                    if (lowerName.includes('tournament') || lowerName.includes('tourney') || lowerName.includes('picker')) {
                        checkAndNotifyEventAvailability(iframe);
                    }
                }
            };

            iframe.onerror = () => {
                showError();
            };

            // Fallback: show game after 5 seconds even if onload doesn't fire
            setTimeout(() => {
                document.getElementById('loadingScreen').style.display = 'none';
                iframe.style.display = 'block';
            }, 5000);
        }

        async function checkAndNotifyEventAvailability(iframe) {
            try {
                const currentUser = getCurrentUser();
                if (!currentUser) {
                    console.log('❌ Check Event: No user logged in.');
                    return;
                }

                // 1. Get ALL Active Events
                const today = new Date().toISOString().split('T')[0];
                const { data: events, error: eventError } = await sbClient
                    .from('events')
                    .select('id, title, host_id')
                    .gte('date', today)
                    .order('date', { ascending: true });

                if (eventError) console.error('❌ Check Event Error:', eventError);
                if (!events || events.length === 0) {
                    console.log('❌ Check Event: No active events found.');
                    return;
                }

                console.log(`📅 Found ${events.length} Active Events. Checking Permissions...`);

                // 2. Filter Events based on Permissions
                const isAdmin = (currentUser.user_level || '').toLowerCase() === 'admin';
                const availableEvents = events.filter(event => {
                    const isHost = event.host_id === currentUser.id;
                    return isAdmin || isHost;
                });

                if (availableEvents.length > 0) {
                    console.log(`✅ Authorized for ${availableEvents.length} events.`);

                    // Send LIST of events (New Standard)
                    iframe.contentWindow.postMessage({
                        type: 'EVENTS_AVAILABLE',
                        events: availableEvents.map(e => ({ id: e.id, title: e.title }))
                    }, '*');

                    // Backward Compatibility (Send first one as single event)
                    // This ensures existing games (like Tourney) still see at least one event
                    iframe.contentWindow.postMessage({
                        type: 'EVENT_AVAILABLE',
                        title: availableEvents[0].title,
                        eventId: availableEvents[0].id
                    }, '*');

                } else {
                    console.log('⛔ Not authorized for any active events.');
                }

            } catch (err) {
                console.error('❌ Error checking event availability:', err);
            }
        }

        async function fetchAndSendParticipants(eventId, title, statusFilter = 'confirmed') {
            try {
                console.log(`🔍 Fetching participants with filter: ${statusFilter}`);

                // Build base query
                let query = sbClient
                    .from('event_registrations')
                    .select(`
                        full_name,
                        profiles (username)
                    `)
                    .eq('event_id', eventId);

                // Apply status filter
                if (statusFilter === 'both') {
                    query = query.in('status', ['confirmed', 'attended']);
                } else {
                    query = query.eq('status', statusFilter);
                }

                const { data: registrations, error: regError } = await query;

                if (regError) {
                    console.error('❌ Supabase Query Error:', regError);
                    throw regError;
                }

                if (!registrations || registrations.length === 0) {
                    console.log(`⚠️ No registrations found for status: ${statusFilter}`);
                    alert(`⚠️ No players found with status: ${statusFilter === 'both' ? 'confirmed or attended' : statusFilter}`);
                    return;
                }

                // Map to names: username from profiles priority, fallback to full_name
                const players = registrations
                    .map(r => r.profiles?.username || r.full_name)
                    .filter(name => name);

                const iframe = document.getElementById('gameIframe');
                if (iframe && iframe.contentWindow) {
                    iframe.contentWindow.postMessage({
                        type: 'LOAD_PLAYERS',
                        players: players,
                        title: title
                    }, '*');
                    console.log(`📤 Sent ${players.length} players to game (filter: ${statusFilter}).`);
                }
            } catch (err) {
                console.error('❌ Error in fetchAndSendParticipants:', err);
            }
        }

        // --- SECURE SCORE & SETTINGS LISTENER ---
        let hasSubmittedThisSession = false;

        window.addEventListener('message', async (event) => {
            if (!event.data) return;

            // ... (Security checks omitted for brevity in replace, assuming context matches)

            // HANDLE EVENT PLAYER REQUEST
            if (event.data.type === 'REQUEST_EVENT_PLAYERS') {
                const statusFilter = event.data.statusFilter || 'confirmed'; // Default to 'confirmed'
                await fetchAndSendParticipants(event.data.eventId, event.data.title, statusFilter);
                return;
            }

            // SECURITY: Only accept messages from the same origin to prevent hijacking
            if (event.origin !== window.location.origin && !window.location.origin.includes('localhost')) {
                console.warn('🚨 Unauthorized message origin:', event.origin);
                return;
            }

            // SECURITY: Verify the message comes from our game iframe
            const iframe = document.getElementById('gameIframe');
            if (event.source !== iframe.contentWindow) {
                console.warn('🚨 Message not from game iframe');
                return;
            }

            // 1. Classic Nobi Messages
            if (event.data.type === 'GAME_SCORE') {
                console.log('🏆 Received Score from Game:', event.data);
                hasSubmittedThisSession = true;
                await handleGameScore(event.data.score, event.data.duration);
            }
            else if (event.data.type === 'SAVE_SETTINGS') {
                console.log('⚙️ Received Settings Update:', event.data.config);
                await handleSaveSettings(event.data.config);
            }

            // 2. New Secure Bridge Protocol (JDK Jumper & future games)
            else if (event.data.type === 'BRIDGE_INIT') {
                console.log('🤝 Bridge Init Request:', event.data.gameName);
                hasSubmittedThisSession = false; // RESET flag for new game session
                const currentUser = getCurrentUser();
                const rewards = window.gameRewards;

                // 🔒 SECURITY: Create new session for retry/restart
                // 🔒 SECURITY: Refresh session on every game initialization (including retries)
                startGameSession(rewards.gameId);

                // Send current user info and game rewards back
                event.source.postMessage({
                    type: 'BRIDGE_INIT_RESPONSE',
                    user: currentUser ? {
                        id: currentUser.id,
                        username: currentUser.username,
                        user_level: currentUser.user_level,
                        avatar_url: currentUser.avatar_url,
                        daily_login_claimed: currentUser.daily_login_claimed
                    } : null,
                    gameRewards: rewards ? {
                        id: rewards.gameId,
                        name: rewards.gameName,
                        points_reward: rewards.pointsReward,
                        xp_reward: rewards.xpReward
                    } : null
                }, '*');
            }
            else if (event.data.type === 'BRIDGE_SUBMIT_SCORE') {
                // Frontend check removed to allow SPA retries. Server handles rate limiting.
                if (false && hasSubmittedThisSession) { // DISABLED
                    console.warn('🛡️ Anti-Hijack: Score already submitted via Bridge.');
                    event.source.postMessage({ type: 'BRIDGE_SUBMIT_RESPONSE', pointsEarned: 0, xpEarned: 0, error: 'ALREADY_SUBMITTED' }, '*');
                    return;
                }
                console.log('🏆 Secure Bridge Score:', event.data.score, 'Duration:', event.data.duration || 0);
                hasSubmittedThisSession = true;

                // Process the score via Edge Function
                const result = await handleGameScore(event.data.score, event.data.duration || 0);

                // Reply with rewards earned
                event.source.postMessage({
                    type: 'BRIDGE_SUBMIT_RESPONSE',
                    pointsEarned: result?.points_added || 0,
                    xpEarned: result?.xp_added || 0
                }, '*');
            }
        });

        async function handleSaveSettings(config) {
            const rewards = window.gameRewards;
            if (!rewards || !rewards.gameId) return;

            try {
                // SECURITY: Route through Edge Function with admin verification
                const { data, error } = await sbClient.functions.invoke('jdk-secure-handler', {
                    body: {
                        action: 'saveGameSettings',
                        game_id: rewards.gameId,
                        config: config
                    }
                });

                if (error) throw error;
                if (!data.success) throw new Error(data.error || 'Unknown error');

                showNotification('✅ Konfigurasi Global Disimpan!');
            } catch (err) {
                console.error('❌ Failed to save global settings:', err);
                showNotification('⛔ ' + (err.message || 'Gagal menyimpan konfigurasi global!'));
            }
        }

        /**
         * 🔒 SECURITY: Start a new game session
         */
        async function startGameSession(gameId) {
            try {
                const { data, error } = await sbClient.functions.invoke('start-game-session', {
                    body: { game_id: gameId }
                });

                if (error) throw error;

                if (data.success) {
                    currentGameSession = {
                        id: data.session_id,
                        startTime: Date.now()
                    };
                    console.log('🔒 Game session started successfully');
                } else {
                    throw new Error(data.error || 'Failed to start game session');
                }
            } catch (err) {
                console.error('❌ Failed to start game session:', err);
                showNotification('⚠️ Failed to initialize game session');
            }
        }

        async function handleGameScore(score, duration) {
            console.log(`🏆 Submitting Score: ${score}, Duration: ${duration}s`);

            const rewards = window.gameRewards;
            const currentUser = getCurrentUser();

            if (!rewards || !gameId) {
                console.error('❌ Error: No Game ID');
                showNotification('⚠️ Game configuration error');
                return;
            }
            if (!currentUser) {
                console.error('❌ Error: User Not Logged In');
                showNotification('⚠️ Please log in to submit scores');
                return;
            }

            try {
                // Call the secure Edge Function with session_id
                const { data, error } = await sbClient.functions.invoke('jdk-secure-handler', {
                    body: {
                        action: 'submitScore',
                        game_id: gameId,
                        score: score,
                        duration_seconds: duration,
                        session_id: currentGameSession?.id // 🔒 Pass session for validation
                    }
                });

                if (error) throw error;

                if (data.success) {
                    console.log('✅ Score recorded securely:', data);

                    // Clear session after successful submission
                    currentGameSession = null;

                    if (data.xp_added > 0) {
                        showNotification(`🎉 Skor Tercatat! +${data.points_added} Points & +${data.xp_added} XP`);
                    } else {
                        showNotification(`🎉 Skor Tercatat! +${data.points_added} Points (Limit XP Harian)`);
                    }
                    return data; // Return for bridge
                } else {
                    throw new Error(data.error || 'Unknown error');
                }

            } catch (err) {
                console.error('❌ Failed to record game rewards:', err);
                showNotification('⛔ Gagal mencatat skor: ' + (err.message || 'Error Server'));

                // If session expired or validation failed, offer to restart
                if (err.message && (err.message.includes('session') || err.message.includes('validation') || err.message.includes('rate limit'))) {
                    setTimeout(() => {
                        if (confirm('Game session error. Restart game?')) {
                            window.location.reload();
                        }
                    }, 2000);
                }
            }
        }

        // Notification helper
        function showNotification(message) {
            const toast = document.createElement('div');
            // Using standard retro styles to match the theme
            toast.style.position = 'fixed';
            toast.style.bottom = '32px';
            toast.style.left = '50%';
            toast.style.transform = 'translateX(-50%)';
            toast.style.backgroundColor = '#000';
            toast.style.color = '#FFD700';
            toast.style.border = '4px solid #FFD700';
            toast.style.padding = '12px 24px';
            toast.style.borderRadius = '16px';
            toast.style.fontWeight = '800';
            toast.style.fontSize = '14px';
            toast.style.boxShadow = '0 10px 25px -5px rgba(0, 0, 0, 0.5)';
            toast.style.zIndex = '999';
            toast.style.fontFamily = "'Plus Jakarta Sans', sans-serif";
            toast.style.textTransform = 'uppercase';
            toast.style.letterSpacing = '1px';
            toast.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
            toast.style.opacity = '0';
            toast.style.marginBottom = '-20px';

            toast.textContent = message;
            document.body.appendChild(toast);

            // Trigger animation
            requestAnimationFrame(() => {
                toast.style.opacity = '1';
                toast.style.marginBottom = '0';
            });

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.marginBottom = '-20px';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function showError() {
            document.getElementById('loadingScreen').style.display = 'none';
            document.getElementById('errorScreen').style.display = 'flex';
        }

        loadGame();
    </script>


</Layout>

<style is:global>

        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #181710;
        }

        .game-header {
            background: linear-gradient(135deg, #FFD700, #FFA500);
            border-bottom: 4px solid #000;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
        }

        .back-btn {
            background: #000;
            color: #FFD700;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 800;
            text-decoration: none;
            border: 3px solid #000;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .back-btn:hover {
            transform: scale(1.05);
            background: #333;
        }

        .game-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #000;
            margin: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .game-rewards {
            margin-left: auto;
            display: flex;
            gap: 12px;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .reward-badge {
            background: #fff;
            border: 3px solid #000;
            border-radius: 20px;
            padding: 4px 12px;
            font-weight: 700;
            font-size: 0.75rem;
        }

        .reward-badge.points {
            color: #f97316;
        }

        .reward-badge.xp {
            color: #8b5cf6;
        }

        .game-container {
            position: fixed;
            top: 60px;
            left: 0;
            right: 0;
            bottom: 0;
        }

        .game-iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        .loading-screen {
            position: absolute;
            inset: 0;
            background: #181710;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 4px solid #333;
            border-top-color: #FFD700;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .error-screen {
            position: absolute;
            inset: 0;
            background: #181710;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-family: 'Plus Jakarta Sans', sans-serif;
            text-align: center;
            padding: 20px;
        }

        .error-screen h2 {
            color: #ef4444;
            margin-bottom: 10px;
        }

        @media (max-width: 640px) {
            .game-title {
                font-size: 0.9rem;
            }

            .game-rewards {
                display: none;
            }

            .back-btn {
                padding: 6px 12px;
                font-size: 0.85rem;
            }
        }
    
</style>
