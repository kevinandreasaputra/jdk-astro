---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="JDK Entertainment - Pusat Komunitas Retro, Pop Culture dan Vintage" 
    description="JDK Entertainment adalah pusat komunitas retro, pop culture, dan marketplace barang vintage/koleksi langka di Indonesia. Mainkan game seru, ikuti event, dan kumpulkan poin."
    preloadImage="https://images.weserv.nl/?url=https%3A%2F%2Fvadcglyhrcuwnfenyzgk.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Fhero-sliders%2Fhero-banners%2F1767023429118-I-Want-You-web-.png&w=1200&q=80&output=webp"
>
    <main>
        <!-- SEO Description: Hidden visually but present for crawlers and screen readers -->
        <span class="sr-only">JDK Entertainment - Pusat Komunitas Retro, Pop Culture dan Vintage Indonesia</span>

        <!-- Hero Slider Section -->
        <section class="hero-slider-section overflow-hidden">
            <div id="hero-slider" class="splide">
                <div class="splide__track">
                    <ul class="splide__list" id="hero-slider-list">
                        <!-- Pre-rendered Static Hero Slide (LCP Optimization) -->
                        <li class="splide__slide" id="hero-slider-slide01">
                            <a href="#" class="block w-full h-full cursor-pointer group">
                                <div class="hero-slide-content min-h-[400px] md:min-h-[500px] lg:min-h-[600px] overflow-hidden relative">
                                    <!-- Full Image Background -->
                                    <img src="https://images.weserv.nl/?url=https%3A%2F%2Fvadcglyhrcuwnfenyzgk.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Fhero-sliders%2Fhero-banners%2F1767023429118-I-Want-You-web-.png&w=1200&q=80&output=webp" 
                                         alt="About JDK Entertainment"
                                         class="w-full h-full object-cover absolute inset-0 transition-transform duration-500 group-hover:scale-105"
                                         width="1200"
                                         height="600"
                                         fetchpriority="high"
                                         loading="eager"
                                         onerror="this.style.display='none'; this.parentElement.style.background='var(--comic-yellow)';">
                                    
                                    <!-- Text Overlay -->
                                    <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 via-black/50 to-transparent p-6 md:p-8 lg:p-12">
                                        <h2 class="text-white text-2xl md:text-4xl lg:text-5xl font-black uppercase tracking-tight drop-shadow-lg mb-2">
                                            About JDK Entertainment
                                        </h2>
                                        <p class="text-white/90 text-sm md:text-lg lg:text-xl font-medium max-w-2xl leading-relaxed">
                                            Tentang JadulKekinian<br>
                                            Komunitas Retro & Pop Culture Indonesia<br><br>
                                            JadulKekinian adalah komunitas pecinta game retro, arcade, dan pop culture jadul dari era 80-an hingga awal 2000-an. Kami mengadakan event mabar, mini gathering, dan eksplorasi nostalgia digital melalui game, toys, dan teknologi modern.
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Progress Bar -->
                <div class="hero-slider-progress">
                    <div class="hero-slider-progress-bar"></div>
                </div>
            </div>
        </section>

        <!-- Events Section (Mockup Style) -->
        <section class="py-24 bg-[#111] border-t border-black/5 relative">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">

                <!-- Section Header -->
                <div class="flex items-center justify-start gap-4 mb-12">
                    <span class="text-primary text-2xl font-black">-</span>
                    <h2 class="text-white text-3xl md:text-4xl font-black uppercase tracking-tight flex items-center gap-3">
                        Event Terdekat
                        <span class="material-symbols-outlined text-primary text-4xl animate-bounce-slow">rocket_launch</span>
                    </h2>
                    <span class="h-px bg-white/20 flex-1 ml-4 hidden md:block"></span>
                </div>

                <div id="upcoming-events-container" class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Dynamic Events Loaded Here -->
                    <div class="col-span-full text-center py-12">
                        <div class="animate-spin inline-block w-8 h-8 border-[3px] border-current border-t-transparent text-primary rounded-full mb-4" role="status" aria-label="loading"></div>
                        <p class="text-white/50 font-bold uppercase tracking-widest text-sm">Memuat Event Terdekat...</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Leaderboard Section (Minimalist) -->
        <section class="py-16 bg-zinc-900">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Section Header -->
                <div class="flex items-center justify-between mb-8">
                    <div class="flex items-center gap-4">
                        <span class="text-primary text-2xl font-black">-</span>
                        <h2 class="text-white text-2xl md:text-3xl font-black uppercase tracking-tight flex items-center gap-3">
                            Top JDKwan
                            <span class="material-symbols-outlined text-primary text-3xl animate-bounce-slow">trophy</span>
                        </h2>
                    </div>
                    <a href="/admin_leaderboard" class="text-primary/80 hover:text-primary text-sm font-bold uppercase tracking-wide transition-colors hidden md:block">
                        Lihat Semua →
                    </a>
                </div>

                <!-- Leaderboard Container -->
                <div id="home-leaderboard" class="flex flex-col md:flex-row items-stretch justify-center gap-4">
                    <!-- Loading State -->
                    <div class="w-full text-center py-8">
                        <div class="animate-spin inline-block w-6 h-6 border-2 border-current border-t-transparent text-primary rounded-full mb-2"></div>
                        <p class="text-white/40 text-sm font-bold uppercase tracking-widest">Memuat...</p>
                    </div>
                </div>

                <!-- Mobile Link -->
                <div class="mt-6 text-center md:hidden">
                    <a href="/admin_leaderboard" class="text-primary/80 hover:text-primary text-sm font-bold uppercase tracking-wide transition-colors">
                        Lihat Semua →
                    </a>
                </div>
            </div>
        </section>

        <!-- Community Activity Section -->
        <section class="bg-zinc-900 py-20">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center gap-4 mb-12">
                    <div class="h-1 bg-comic-yellow w-12"></div>
                    <h2 class="font-display text-3xl md:text-4xl text-white uppercase">KEGIATAN KOMUNITAS</h2>
                    <div class="h-1 bg-comic-yellow flex-grow"></div>
                </div>

                <div id="community-activities-container" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Activity 1: Mabar -->
                    <div class="flex flex-col bg-zinc-800/50 border-2 border-gray-800 rounded-2xl overflow-hidden hover:border-primary transition-all group shadow-lg">
                        <div class="aspect-video relative overflow-hidden">
                            <img src="https://images.weserv.nl/?url=https%3A%2F%2Fplacehold.co%2F600x400%2F333%2FFFD400.png%3Ftext%3DPS1%2BMabar%2BNight&w=400&q=80&output=webp" alt="Mabar Rutin" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" width="600" height="400" loading="lazy">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                            <div class="absolute bottom-4 left-4">
                                <span class="bg-primary text-black text-[10px] font-black px-2 py-0.5 rounded uppercase tracking-tighter">Setiap Bulan</span>
                            </div>
                        </div>
                        <div class="p-6">
                            <h3 class="text-white text-xl font-black uppercase mb-2">MABAR RUTIN</h3>
                            <p class="text-gray-400 text-sm font-medium leading-relaxed">
                                Main bareng game jadul, dari PS1 sampai Arcade. Kompetisi santai dengan hadiah menarik & nostalgia tanpa batas.
                            </p>
                        </div>
                    </div>

                    <!-- Activity 2: Gathering -->
                    <div class="flex flex-col bg-zinc-800/50 border-2 border-gray-800 rounded-2xl overflow-hidden hover:border-primary transition-all group shadow-lg">
                        <div class="aspect-video relative overflow-hidden">
                            <img src="https://images.weserv.nl/?url=https%3A%2F%2Fplacehold.co%2F600x400%2F333%2FFFD400.png%3Ftext%3DKopsan%2BJDK&w=400&q=80&output=webp" alt="Gathering" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" width="600" height="400" loading="lazy">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                            <div class="absolute bottom-4 left-4">
                                <span class="bg-primary text-black text-[10px] font-black px-2 py-0.5 rounded uppercase tracking-tighter">Gathering</span>
                            </div>
                        </div>
                        <div class="p-6">
                            <h3 class="text-white text-xl font-black uppercase mb-2">GATHERING & KOPSAN</h3>
                            <p class="text-gray-400 text-sm font-medium leading-relaxed">
                                Ngumpul santai (Kopi Santai), tukar info koleksi, dan mempererat tali persaudaraan antar sesama pecinta Pop Culture.
                            </p>
                        </div>
                    </div>

                    <!-- Activity 3: Workshop -->
                    <div class="flex flex-col bg-zinc-800/50 border-2 border-gray-800 rounded-2xl overflow-hidden hover:border-primary transition-all group shadow-lg">
                        <div class="aspect-video relative overflow-hidden">
                            <img src="https://images.weserv.nl/?url=https%3A%2F%2Fplacehold.co%2F600x400%2F333%2FFFD400.png%3Ftext%3DWorkshop%2BRetro&w=400&q=80&output=webp" alt="Workshop" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" width="600" height="400" loading="lazy">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                            <div class="absolute bottom-4 left-4">
                                <span class="bg-primary text-black text-[10px] font-black px-2 py-0.5 rounded uppercase tracking-tighter">Belajar Bersama</span>
                            </div>
                        </div>
                        <div class="p-6">
                            <h3 class="text-white text-xl font-black uppercase mb-2">WORKSHOP & SHARING</h3>
                            <p class="text-gray-400 text-sm font-medium leading-relaxed">
                                Sharing session tentang servis console, restorasi mainan, hingga tips hunting barang langka di pasar loak.
                            </p>
                        </div>
                    </div>
                </div>
                <p class="text-gray-400 mt-6 font-body text-lg italic">Lebih dari sekadar nostalgia - ini kebersamaan.</p>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="bg-comic-yellow py-12 border-t-4 border-black">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-8">
                <div>
                    <h2 class="font-display text-4xl text-black mb-2">Siap nostalgia bareng?</h2>
                    <p class="font-body text-xl text-black font-bold">Gabung jadi JDKwan sekarang.</p>
                </div>
                <button onclick="openRegisterModal()" class="bg-black text-comic-yellow font-display text-lg md:text-2xl px-8 py-3 md:px-12 md:py-4 border-4 border-black hover:scale-105 transition-transform shadow-[4px_4px_0px_0px_rgba(255,255,255,0.2)] md:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.2)]">
                    DAFTAR MEMBER JDK ▸
                </button>
            </div>
        </section>

        <!-- Additional Spacer -->
        <div class="h-12 bg-zinc-900 border-l-4 border-r-4 border-black max-w-7xl mx-auto opacity-50"></div>
    </main>

    <!-- Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "JDK Entertainment",
      "url": "https://jadulkekinian.com/",
      "logo": "https://jadulkekinian.com/images/jdk-logo.png",
      "description": "Pusat komunitas retro, vintage, dan pop culture di Indonesia.",
      "sameAs": [
        "https://www.instagram.com/jadulkekinian/"
      ]
    }
    </script>
</Layout>

<style>
    :root {
        --orbit-radius: 120px;
    }

    @media (min-width: 768px) {
        :root {
            --orbit-radius: 200px;
        }
    }

    @media (min-width: 1024px) {
        :root {
            --orbit-radius: 280px;
        }
    }

    /* Critical LCP CSS: Ensure Slide 1 displays instantly before Splide JS runs */
    #hero-slider:not(.is-initialized) {
        display: block;
        position: relative;
        width: 100%;
    }
    #hero-slider:not(.is-initialized) .splide__track {
        display: block;
        overflow: hidden;
        position: relative;
        height: 100% !important;
    }
    #hero-slider:not(.is-initialized) .splide__list {
        display: flex !important;
        padding: 0;
        margin: 0;
        list-style: none;
        height: 100% !important;
    }
    #hero-slider:not(.is-initialized) .splide__slide {
        width: 100%;
        flex-shrink: 0;
        display: none !important;
        height: 100% !important;
    }
    #hero-slider:not(.is-initialized) #hero-slider-slide01 {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
    }
</style>
