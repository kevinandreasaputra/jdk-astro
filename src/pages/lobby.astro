---
import Layout from '../layouts/Layout.astro';
---

<Layout title="JDK Lobby - Global Community Chat" description="Lobby Chat JDK Entertainment - Ngobrol seru bareng komunitas pecinta retro dan pop culture.">
    <main class="flex-1 flex flex-col bg-white min-w-0">

        <!-- Chat Header -->
        <header
            class="h-14 px-4 border-b border-[var(--border-color)] flex items-center justify-between flex-shrink-0 bg-white/80 backdrop-blur z-10">
            <div class="flex items-center gap-2 overflow-hidden">
                <span class="material-symbols-outlined text-zinc-400 text-xl">tag</span>
                <h2 class="font-bold text-zinc-900 text-base truncate">lobby</h2>
                <div class="hidden sm:block h-4 w-[1px] bg-zinc-300 mx-2"></div>
                <p class="hidden sm:block text-xs text-zinc-500 truncate">Ruang diskusi utama komunitas JDK.</p>
            </div>

            <div class="flex items-center gap-4 text-zinc-500">
                <!-- Mobile Menu Toggle -->
                <button class="lg:hidden p-1 hover:bg-zinc-100 rounded" onclick="toggleLobbySidebar()">
                    <span class="material-symbols-outlined">menu</span>
                </button>

                <div class="hidden lg:flex items-center gap-4">
                    <button class="hover:text-zinc-900 transition-colors" title="Search">
                        <span class="material-symbols-outlined text-xl">search</span>
                    </button>
                    <button class="hover:text-zinc-900 transition-colors relative" title="Notifications">
                        <span class="material-symbols-outlined text-xl">notifications</span>
                        <div class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></div>
                    </button>
                    <button onclick="toggleRightSidebar()" class="hover:text-zinc-900 transition-colors text-zinc-900"
                        title="Members">
                        <span class="material-symbols-outlined text-xl">group</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Message List -->
        <div id="chatFeed" class="flex-1 overflow-y-auto p-4 space-y-4 scroll-smooth">
            <!-- Messages will be injected here by lobby.js -->
            <div class="flex flex-col items-center justify-center h-full gap-4 text-zinc-300">
                <div class="w-16 h-16 bg-zinc-100 rounded-full flex items-center justify-center">
                    <span class="material-symbols-outlined text-3xl">chat_bubble_outline</span>
                </div>
                <div class="text-sm font-medium animate-pulse">Connecting to JDK...</div>
            </div>
        </div>

        <!-- Composer Area -->
        <div class="p-4 pt-2">
            <!-- Reply Bar -->
            <div id="activeReplyBar"
                class="hidden flex items-center justify-between bg-zinc-50 px-3 py-2 rounded-t-lg border border-b-0 border-zinc-200 text-xs">
                <span class="text-zinc-500">Replying to <span id="replyRecipient"
                        class="font-bold text-zinc-900">@user</span></span>
                <button onclick="window.cancelReply()" class="text-zinc-400 hover:text-red-500">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>

            <!-- Image Preview -->
            <div id="imagePreviewContainer"
                class="hidden bg-zinc-50 px-3 py-2 border border-b-0 border-zinc-200 rounded-t-lg flex items-center gap-3">
                <img id="imagePreview" src="" class="w-12 h-12 rounded object-cover border border-zinc-200">
                <div class="flex-1 min-w-0">
                    <p class="text-[10px] font-bold text-zinc-500 uppercase">Attached</p>
                    <p id="imageFileName" class="text-xs text-zinc-900 truncate">image.jpg</p>
                </div>
                <button onclick="window.clearImageSelection()" class="text-zinc-400 hover:text-red-500">
                    <span class="material-symbols-outlined">delete</span>
                </button>
            </div>

            <!-- Input Container -->
            <div
                class="bg-white p-2 rounded-xl flex flex-col gap-1 border-2 border-[var(--border-color)] focus-within:border-zinc-400 transition-all">
                <div class="flex-1 relative">
                    <div id="mentionSuggestions"
                        class="absolute bottom-full mb-2 left-0 w-64 bg-white border border-zinc-200 rounded-lg shadow-xl hidden z-50 overflow-hidden">
                        <div class="bg-zinc-50 px-3 py-1 text-[10px] font-bold text-zinc-500 uppercase">Members</div>
                        <div id="mentionList" class="max-h-40 overflow-y-auto"></div>
                    </div>

                    <textarea id="chatInput" rows="1"
                        class="w-full bg-transparent border-none p-2 text-sm text-zinc-900 placeholder-zinc-400 focus:ring-0 resize-none max-h-32"
                        placeholder="Message #lobby"></textarea>
                </div>

                <div class="flex items-center justify-between border-t border-zinc-100 pt-2 pb-1 px-1">
                    <div class="flex items-center gap-1">
                        <button onclick="document.getElementById('lobbyImageInput').click()"
                            class="p-1.5 text-zinc-400 hover:text-zinc-900 hover:bg-zinc-100 rounded transition-colors">
                            <span class="material-symbols-outlined text-xl">add</span>
                        </button>
                        <button onclick="window.toggleStickerPicker('chatInput')"
                            class="p-1.5 text-zinc-400 hover:text-zinc-900 hover:bg-zinc-100 rounded transition-colors">
                            <span class="material-symbols-outlined text-xl">sentiment_satisfied</span>
                        </button>
                        <button
                            class="p-1.5 text-zinc-400 hover:text-zinc-900 hover:bg-zinc-100 rounded transition-colors">
                            <span class="material-symbols-outlined text-xl">alternate_email</span>
                        </button>
                    </div>
                    <!-- Send Button -->
                    <button id="btnSendChat"
                        class="p-1.5 text-zinc-400 hover:text-[#1164A3] transition-all transform active:scale-95">
                        <span class="material-symbols-outlined text-2xl">send</span>
                    </button>
                </div>
            </div>

            <div id="typingIndicator" class="hidden px-2 py-1 text-[10px] font-bold text-zinc-400 animate-pulse">Someone
                is typing...</div>
        </div>
    </main>

</Layout>

<style is:global>

        :root {
            --sidebar-bg: #ffd400;
            /* JDK Yellow */
            --sidebar-text: #000000;
            --sidebar-hover: #facc15;
            /* yellow-400 for lighter hover or use a shadow */
            --border-color: #e2e2e2;
            --bg-main: #ffffff;
            --primary: #ffd400;
        }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            background-color: var(--bg-main);
            color: #18181b;
            /* zinc-900 */
        }

        /* Scrollbar styling */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #d4d4d8;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #a1a1aa;
        }

        /* Mobile Overlay Safety */
        #mobileOverlay:not(.hidden) {
            background-color: rgba(0, 0, 0, 0.5) !important;
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
        }
    
</style>
