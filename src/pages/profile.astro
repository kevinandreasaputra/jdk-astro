---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Profile - JDK Entertainment" description="Member Dashboard JDK Entertainment - Kelola profil, lihat statistik, dan raih achievement">
    <main class="w-full min-h-screen relative">
        <!-- Navbar (Mockup Style) -->
        

        <!-- Profile Header (Clean SaaS Dashboard) -->
        <section class="relative">
            <div class="profile-cover">
                <div class="absolute bottom-4 right-6 flex gap-2 z-10">
                    <div
                        class="bg-white/10 backdrop-blur-md text-white/90 px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-widest border border-white/20">
                        Host Member
                    </div>
                </div>
            </div>

            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <div class="profile-header-content flex flex-col md:flex-row items-end md:items-start gap-6">
                    <!-- Avatar -->
                    <div class="relative group">
                        <div class="p-1 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl shadow-lg">
                            <img id="profileAvatar"
                                class="w-28 h-28 md:w-36 md:h-36 rounded-xl bg-white object-cover group-hover:scale-[1.02] transition-transform"
                                src="" alt="Profile">
                        </div>
                        <div id="profileRankBadge"
                            class="absolute -bottom-2 -right-2 bg-white text-black rounded-lg w-12 h-12 flex items-center justify-center border border-gray-200 p-1 hidden shadow-md">
                            <img src="" alt="Rank Badge" class="w-full h-full object-contain">
                        </div>
                    </div>

                    <!-- Info -->
                    <div class="flex-1 pb-2 text-center md:text-left">
                        <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 mb-3">
                            <h1 id="profileDisplayName"
                                class="text-slate-900 text-2xl md:text-4xl font-bold tracking-tight">JDKWAN</h1>
                            <div class="flex items-center justify-center md:justify-start gap-2">
                                <span id="profileDisplayLevel"
                                    class="rank-pill bg-indigo-50 text-indigo-700 border-indigo-200">JDKWAN</span>
                                <span id="profileDisplayRole"
                                    class="rank-pill bg-slate-50 text-slate-600 border-slate-200">Novice</span>
                            </div>
                        </div>

                        <div
                            class="flex items-center justify-center md:justify-start flex-wrap gap-4 text-sm font-medium text-slate-500 mb-6">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-sm text-slate-400">calendar_today</span>
                                <span id="profileDisplayJoinDate">Joined Dec 2025</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-sm text-indigo-400">stars</span>
                                <span id="profileDisplayXp">2,450 XP</span>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                            <div id="selfButtons" class="flex flex-wrap gap-2">
                                <button id="adminBtn" onclick="window.location.href='admin.html'"
                                    class="hidden bg-slate-900 text-white px-5 py-2 rounded-lg font-semibold hover:bg-slate-800 transition-all text-xs">
                                    👑 Admin Control
                                </button>
                                <button onclick="editProfile()"
                                    class="bg-white text-slate-700 border border-slate-300 px-5 py-2 rounded-lg font-semibold hover:bg-slate-50 hover:border-slate-400 transition-all text-xs">
                                    ✏️ Edit Profile
                                </button>
                                <button onclick="handleLogout()"
                                    class="bg-red-50 text-red-600 border border-red-200 px-5 py-2 rounded-lg font-semibold hover:bg-red-100 transition-colors text-xs">
                                    🚪 Logout
                                </button>
                            </div>
                            <div id="publicButtons" class="hidden flex flex-wrap gap-2">
                                <button id="btnLike" onclick="handleLikeToggle()"
                                    class="bg-pink-500 text-white px-5 py-2 rounded-lg font-semibold hover:bg-pink-600 transition-all text-xs flex items-center gap-2">
                                    <span id="likeHeart">🤍</span> LIKE <span id="likeCount" class="ml-1">0</span>
                                </button>
                                <button onclick="window.history.back()"
                                    class="bg-slate-100 text-slate-700 border border-slate-200 px-5 py-2 rounded-lg font-semibold hover:bg-slate-200 transition-all text-xs">
                                    🔙 Back
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 mt-10 mb-8">
                    <div class="dashboard-stat-card group">
                        <span class="icon">💰</span>
                        <div id="profileStatPoints" class="text-2xl font-bold text-slate-900">0</div>
                        <div class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">JDK Points</div>
                    </div>
                    <div class="dashboard-stat-card">
                        <span class="icon">🪙</span>
                        <div id="profileStatCoin" class="text-2xl font-bold text-slate-900">0</div>
                        <div class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">Coins</div>
                    </div>
                    <div class="dashboard-stat-card">
                        <span class="icon">📅</span>
                        <div id="profileStatEvents" class="text-2xl font-bold text-slate-900">0</div>
                        <div class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">Events</div>
                    </div>
                    <div class="dashboard-stat-card">
                        <span class="icon">📦</span>
                        <div id="profileStatSales" class="text-2xl font-bold text-slate-900">0</div>
                        <div class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">Sales</div>
                    </div>
                    <div class="dashboard-stat-card col-span-2 sm:col-span-1">
                        <span class="icon">🏆</span>
                        <div id="profileStatAchievements" class="text-2xl font-bold text-slate-900">0</div>
                        <div class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">Badges</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Navigation Tabs -->
        <section class="sticky top-16 md:top-20 z-40 bg-white/90 backdrop-blur-lg border-b border-slate-200/80 mb-8">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex overflow-x-auto no-scrollbar gap-1 md:gap-2 h-12 items-center">
                    <button class="tab-button tab-button-modern active whitespace-nowrap"
                        onclick="switchTab('overview')">
                        Overview
                    </button>
                    <button class="tab-button tab-button-modern whitespace-nowrap" onclick="switchTab('events')">
                        Events
                    </button>
                    <button class="tab-button tab-button-modern whitespace-nowrap" onclick="switchTab('marketplace')">
                        JDK Box
                    </button>
                    <button id="tabHost" class="tab-button tab-button-modern hidden whitespace-nowrap"
                        onclick="switchTab('host')">
                        My Host
                    </button>
                    <button class="tab-button tab-button-modern whitespace-nowrap" onclick="switchTab('achievements')">
                        Badges
                    </button>
                    <button id="tabSettings" class="tab-button tab-button-modern whitespace-nowrap"
                        onclick="switchTab('settings')">
                        Settings
                    </button>
                    <button id="tabWallet" class="tab-button tab-button-modern whitespace-nowrap"
                        onclick="switchTab('wallet')">
                        Wallet
                    </button>
                    <button id="tabRekber" class="tab-button tab-button-modern whitespace-nowrap"
                        onclick="switchTab('rekber')">
                        Rekber
                    </button>
                </div>
            </div>
        </section>

        <!-- Tab Content -->
        <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Tab Content -->

            <!-- Wallet Tab -->
            <div id="walletTab" class="tab-content hidden animate-fade-in-down">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-lg font-bold text-slate-900">Dompet & Saldo</h3>
                        <div class="text-primary-dark text-xl font-black">Saldo: <span id="walletBalance">0</span> 🪙
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-slate-50 border-b border-slate-200">
                                <tr>
                                    <th class="p-3 font-semibold uppercase text-xs text-slate-500">Waktu</th>
                                    <th class="p-3 font-semibold uppercase text-xs text-slate-500">Tipe</th>
                                    <th class="p-3 font-semibold uppercase text-xs text-slate-500">Jumlah</th>
                                    <th class="p-3 font-semibold uppercase text-xs text-slate-500">Keterangan</th>
                                </tr>
                            </thead>
                            <tbody id="walletHistoryBody"
                                class="text-gray-700 font-bold text-sm divide-y divide-gray-200">
                                <tr>
                                    <td colspan="4" class="p-4 text-center">Memuat riwayat...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-12 border-t border-black/10 pt-8">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-lg font-bold text-slate-900">Riwayat JDK Points</h3>
                            <div class="text-indigo-600 text-lg font-bold">Total: <span id="pointTabBalance">0</span> ⭐
                            </div>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-slate-50 border-b border-slate-200">
                                    <tr>
                                        <th class="p-3 font-semibold uppercase text-xs text-slate-500">Waktu</th>
                                        <th class="p-3 font-semibold uppercase text-xs text-slate-500">Tipe</th>
                                        <th class="p-3 font-semibold uppercase text-xs text-slate-500">Jumlah</th>
                                        <th class="p-3 font-semibold uppercase text-xs text-slate-500">Keterangan</th>
                                    </tr>
                                </thead>
                                <tbody id="pointHistoryBody"
                                    class="text-gray-700 font-bold text-sm divide-y divide-gray-200">
                                    <tr>
                                        <td colspan="4" class="p-4 text-center text-gray-500">Memuat riwayat...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rekber Tab -->
            <div id="rekberTab" class="tab-content hidden animate-fade-in-down">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-lg font-bold text-slate-900">Transaksi Rekber Saya</h3>
                    </div>
                    <div id="userRekberList" class="space-y-4">
                        <div class="text-center py-12 text-gray-400 font-bold text-sm animate-pulse">
                            Memuat transaksi...
                        </div>
                    </div>
                </div>
            </div>

            <!-- Overview Tab -->
            <div id="overviewTab" class="tab-content animate-fade-in-down pb-12">
                <div class="grid lg:grid-cols-3 gap-8 mb-8">
                    <!-- Chart -->
                    <div class="lg:col-span-2 bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">Point Analytics</h3>
                                <p class="text-xs font-medium text-slate-400">Performance over time</p>
                            </div>
                            <div class="text-indigo-600 font-semibold text-sm bg-indigo-50 px-3 py-1 rounded-full">
                                +12% this month
                            </div>
                        </div>
                        <div id="pointsChart" class="h-80 w-full"></div>
                    </div>

                    <!-- Activity -->
                    <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm flex flex-col">
                        <div class="mb-6">
                            <h3 class="text-lg font-bold text-slate-900">Activity Log</h3>
                            <p class="text-xs font-medium text-slate-400">Your latest actions</p>
                        </div>
                        <div id="recentActivityList" class="space-y-4 flex-1 overflow-y-auto pr-2 no-scrollbar">
                            <div class="text-center py-8 text-gray-400 font-bold text-sm animate-pulse">
                                Loading feeds...
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="grid md:grid-cols-4 gap-6 mt-8">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
                        <div class="w-12 h-12 bg-indigo-50 rounded-xl flex items-center justify-center mx-auto mb-3">
                            <span class="text-2xl">📈</span>
                        </div>
                        <h4 id="cardLevel" class="text-lg font-bold text-slate-900 mb-0.5">Level 1</h4>
                        <p id="cardRole" class="text-sm font-medium text-slate-500 mb-4">JDKwan</p>
                        <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                            <div id="cardProgress" class="h-full bg-indigo-500 rounded-full transition-all"
                                style="width: 0%"></div>
                        </div>
                        <p id="cardXpText" class="text-xs font-medium text-slate-400 mt-2">0/1000 XP</p>
                    </div>

                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
                        <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center mx-auto mb-3">
                            <span class="text-2xl">🏆</span>
                        </div>
                        <h4 id="cardAchieveCount" class="text-lg font-bold text-slate-900 mb-0.5">0</h4>
                        <p class="text-sm font-medium text-slate-500 mb-4">Achievement</p>
                        <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                            <div id="cardAchieveBar" class="h-full bg-blue-500 rounded-full transition-all"
                                style="width: 0%"></div>
                        </div>
                        <p id="cardAchieveText" class="text-xs font-medium text-slate-400 mt-2">0/0 Unlocked</p>
                    </div>

                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
                        <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center mx-auto mb-3">
                            <span class="text-2xl">🎮</span>
                        </div>
                        <h4 id="cardEventCount" class="text-lg font-bold text-slate-900 mb-0.5">0</h4>
                        <p class="text-sm font-medium text-slate-500 mb-4">Event Diikuti</p>
                        <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                            <div id="cardEventBar" class="h-full bg-purple-500 rounded-full transition-all"
                                style="width: 0%"></div>
                        </div>
                        <p id="cardEventText" class="text-xs font-medium text-slate-400 mt-2">0/0 Yearly</p>
                    </div>

                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
                        <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center mx-auto mb-3">
                            <span class="text-2xl">💰</span>
                        </div>
                        <h4 id="cardSalesCount" class="text-lg font-bold text-slate-900 mb-0.5">0</h4>
                        <p class="text-sm font-medium text-slate-500 mb-4">Barang Terjual</p>
                        <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                            <div id="cardSalesBar" class="h-full bg-emerald-500 rounded-full transition-all"
                                style="width: 0%"></div>
                        </div>
                        <p id="cardSalesText" class="text-xs font-medium text-slate-400 mt-2">0/0 Monthly</p>
                    </div>
                </div>
            </div>

            <!-- Events Tab -->
            <div id="eventsTab" class="tab-content hidden animate-fade-in-down">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-lg font-bold text-slate-900 mb-6">Event yang Saya Ikuti</h3>
                    <div class="space-y-4" id="userEventsList">
                        <div
                            class="bg-gray-100 rounded-lg p-4 animate-pulse text-center text-gray-400 text-sm font-bold">
                            Memuat data event...
                        </div>
                    </div>
                </div>
            </div>

            <!-- My Host Tab -->
            <div id="hostTab" class="tab-content hidden animate-fade-in-down">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-lg font-bold text-slate-900 mb-6">Event yang Saya Host</h3>
                    <div id="hostEventsList" class="space-y-4">
                        <div class="text-center py-12 text-gray-400 font-bold text-sm animate-pulse">
                            Memuat data event host...
                        </div>
                    </div>
                </div>
            </div>

            <!-- Marketplace Tab -->
            <div id="marketplaceTab" class="tab-content hidden animate-fade-in-down">
                <div class="grid md:grid-cols-2 gap-8">
                    <!-- Products List -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                        <h3 class="text-lg font-bold text-slate-900 mb-6">Barang Dijual</h3>
                        <div id="profileMarketplaceList" class="space-y-4">
                            <!-- Placeholder -->
                            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 flex items-center gap-4">
                                <div class="w-16 h-16 bg-gray-200 rounded-lg"></div>
                                <div class="flex-1">
                                    <div class="h-4 bg-gray-200 rounded w-1/2 mb-2"></div>
                                    <div class="h-3 bg-gray-200 rounded w-1/4"></div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-6">
                            <button onclick="window.location.href='marketplace.html'"
                                class="w-full bg-indigo-600 text-white py-2.5 rounded-lg font-semibold hover:bg-indigo-700 transition-colors text-sm">
                                + Tambah Barang
                            </button>
                        </div>
                    </div>

                    <!-- Stats -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                        <h3 class="text-lg font-bold text-slate-900 mb-6">Statistik Penjualan</h3>
                        <div id="salesChart" class="h-64"></div>
                        <div class="mt-6 space-y-3">
                            <div class="flex justify-between items-center border-b border-gray-100 pb-2">
                                <span class="text-gray-600 font-bold text-sm">Total Penjualan</span>
                                <span id="statTotalSalesValue" class="text-black font-black">Rp 0</span>
                            </div>
                            <div class="flex justify-between items-center border-b border-gray-100 pb-2">
                                <span class="text-gray-600 font-bold text-sm">Barang Terjual</span>
                                <span id="statTotalItemsSold" class="text-black font-black">0 item</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-gray-600 font-bold text-sm">Rating Rata-rata</span>
                                <span class="text-black font-black">⭐ 4.8/5.0</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Achievements Tab -->
            <div id="achievementsTab" class="tab-content hidden animate-fade-in-down">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-lg font-bold text-slate-900 mb-6">Achievement & Badges</h3>
                    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-6" id="achievementGrid">
                        <div class="col-span-full py-12 text-center text-gray-400 font-bold text-sm animate-pulse">
                            Memuat koleksi achievement...
                        </div>
                    </div>
                </div>
            </div>

            <!-- Settings Tab -->
            <div id="settingsTab" class="tab-content hidden animate-fade-in-down">
                <div class="grid md:grid-cols-2 gap-8">
                    <!-- Edit Form -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                        <h3 class="text-lg font-bold text-slate-900 mb-6">Edit Profil</h3>
                        <form id="profileForm" class="space-y-4" onsubmit="return submitProfileUpdate(event)">
                            <div class="text-center mb-6">
                                <div class="relative inline-block group">
                                    <img id="avatarPreview"
                                        class="w-32 h-32 rounded-full border-4 border-black object-cover bg-gray-100"
                                        src="" alt="Avatar">
                                    <label for="avatarInput"
                                        class="absolute bottom-0 right-0 bg-primary text-black w-10 h-10 rounded-full flex items-center justify-center cursor-pointer border-2 border-black hover:bg-white transition-colors">
                                        📷
                                    </label>
                                    <input type="file" id="avatarInput" accept="image/*" class="hidden"
                                        onchange="previewAvatar(this)">
                                </div>
                            </div>

                            <div>
                                <label class="block font-bold text-xs uppercase mb-1">Nama Lengkap</label>
                                <input type="text" id="profileFullName"
                                    class="w-full bg-gray-50 border border-gray-300 rounded-lg p-3 font-bold text-sm focus:border-black focus:ring-1 focus:ring-black">
                            </div>
                            <div>
                                <label class="block font-bold text-xs uppercase mb-1">Username</label>
                                <input type="text" id="profileUsername"
                                    class="w-full bg-gray-50 border border-gray-300 rounded-lg p-3 font-bold text-sm focus:border-black focus:ring-1 focus:ring-black">
                            </div>
                            <div>
                                <label class="block font-bold text-xs uppercase mb-1">Tanggal Lahir</label>
                                <input type="date" id="profileBirthdate"
                                    class="w-full bg-gray-50 border border-gray-300 rounded-lg p-3 font-bold text-sm">
                            </div>
                            <div>
                                <label class="block font-bold text-xs uppercase mb-1">Domisili</label>
                                <select id="profileDomicile"
                                    class="w-full bg-gray-50 border border-gray-300 rounded-lg p-3 font-bold text-sm">
                                    <option value="">Pilih Provinsi</option>
                                    <option value="DKI Jakarta">DKI Jakarta</option>
                                    <!-- Add other options via JS or keep static if critical -->
                                    <option value="Jawa Barat">Jawa Barat</option>
                                </select>
                            </div>
                            <div>
                                <label class="block font-bold text-xs uppercase mb-1">Bio</label>
                                <textarea id="profileBio" rows="3"
                                    class="w-full bg-gray-50 border border-gray-300 rounded-lg p-3 font-bold text-sm"
                                    placeholder="Ceritakan tentang dirimu..."></textarea>
                            </div>

                            <button type="submit"
                                class="w-full bg-indigo-600 text-white py-2.5 rounded-lg font-semibold hover:bg-indigo-700 transition-colors mt-4 text-sm">
                                💾 Simpan Perubahan
                            </button>
                        </form>
                    </div>

                    <!-- Side Info -->
                    <div class="space-y-6">
                        <!-- Read-only Stats -->
                        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                            <h3 class="text-lg font-bold text-slate-900 mb-6">Status JDKwan</h3>
                            <div class="space-y-4">
                                <div
                                    class="flex justify-between items-center p-3 bg-yellow-50 rounded-lg border border-yellow-200">
                                    <span class="font-bold text-sm uppercase">User Level</span>
                                    <span id="profileUserLevel"
                                        class="font-black text-black bg-white px-3 py-1 rounded border border-black/10">JDKwan</span>
                                </div>
                                <div
                                    class="flex justify-between items-center p-3 bg-orange-50 rounded-lg border border-orange-200">
                                    <span class="font-bold text-sm uppercase">JDK Points</span>
                                    <span id="profilePoints"
                                        class="font-black text-black bg-white px-3 py-1 rounded border border-black/10">0</span>
                                </div>
                                <div
                                    class="flex justify-between items-center p-3 bg-green-50 rounded-lg border border-green-200">
