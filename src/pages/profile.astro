        <!-- Scripts (Duplicate Logic Preservation) -->
        <script>
            // Toggle Password Visibility
            function togglePassword(inputId, btn) {
                const input = document.getElementById(inputId);
                if (input.type === 'password') {
                    input.type = 'text';
                    btn.textContent = '🙈';
                } else {
                    input.type = 'password';
                    btn.textContent = '👁';
                }
            }

            // Open Change Password Modal
            function openChangePasswordModal(isRecovery = false) {
                const modal = document.getElementById('changePasswordModal');
                modal.classList.remove('hidden');
                modal.classList.add('flex');

                // Clear inputs
                document.getElementById('oldPassword').value = '';
                document.getElementById('newPassword').value = '';
                document.getElementById('confirmPassword').value = '';

                // Handle Recovery Mode
                const oldPassInput = document.getElementById('oldPassword');
                const oldPassContainer = oldPassInput.closest('.relative').parentElement;
                const title = modal.querySelector('.comic-modal-title');

                if (isRecovery) {
                    oldPassContainer.classList.add('hidden');
                    document.getElementById('oldPassword').removeAttribute('required');
                    modal.dataset.mode = 'recovery';
                    if (title) title.textContent = 'RESET PASSWORD';
                } else {
                    oldPassContainer.classList.remove('hidden');
                    document.getElementById('oldPassword').setAttribute('required', 'true');
                    delete modal.dataset.mode;
                    if (title) title.textContent = 'GANTI PASSWORD';
                }
            }

            // Close Change Password Modal
            async function closeChangePasswordModal() {
                const modal = document.getElementById('changePasswordModal');
                if (!modal) return;

                const isRecovery = modal.dataset.mode === 'recovery';

                modal.classList.add('hidden');
                modal.classList.remove('flex');

                // SECURITY: Force logout if in recovery mode and modal closed without completing
                if (isRecovery && sessionStorage.getItem('jdk_recovery_mode') === 'true') {
                    showNotification('⚠️ Kamu harus menyelesaikan reset password. Silakan login kembali.');
                    sessionStorage.removeItem('jdk_recovery_mode');

                    history.pushState("", document.title, window.location.pathname + window.location.search);

                    if (typeof sbClient !== 'undefined' && sbClient) {
                        await sbClient.auth.signOut();
                    }
                    setTimeout(() => window.location.href = 'index.html', 2000);
                }
            }

            // Submit Change Password
            async function submitChangePassword() {
                const oldPassword = document.getElementById('oldPassword').value;
                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;

                const modal = document.getElementById('changePasswordModal');
                const isRecovery = modal.dataset.mode === 'recovery';

                if (!isRecovery && !oldPassword) {
                    showNotification('⚠️ Masukkan password lama dulu, JDKwan!');
                    return;
                }
                if (!newPassword) {
                    showNotification('⚠️ Password baru harus diisi!');
                    return;
                }
                if (newPassword.length < 6) {
                    showNotification('⚠️ Password baru minimal 6 karakter ya!');
                    return;
                }
                if (newPassword !== confirmPassword) {
                    showNotification('❌ Password baru dan konfirmasi tidak cocok!');
                    return;
                }

                try {
                    // Get Supabase client
                    const { createClient } = supabase;
                    const sbClient = createClient(
                        'https://cikrwqyozevzqxnefqol.supabase.co',
                        'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNpa3J3cXlvemV2enF4bmVmcW9sIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzI4MzQ1OTgsImV4cCI6MjA0ODQxMDU5OH0.9QCplMr4mG1cIi_RUxVPL7ivLoMFNmf31q5Ue_IKqHg'
                    );

                    if (!isRecovery) {
                        const { data: { user } } = await sbClient.auth.getUser();
                        if (!user) {
                            showNotification('❌ Session expired. Silakan login ulang.');
                            return;
                        }
                    }

                    const { error } = await sbClient.auth.updateUser({
                        password: newPassword
                    });

                    if (error) {
                        showNotification('❌ Gagal update password: ' + error.message);
                        return;
                    }

                    showNotification('✅ Password berhasil diubah! Tetap jaga keamanan akunmu ya, JDKwan! 🛡️');
                    closeChangePasswordModal();

                } catch (err) {
                    console.error('Change password error:', err);
                    showNotification('❌ Terjadi kesalahan: ' + err.message);
                }
            }

            // Close modal when clicking outside
            document.getElementById('changePasswordModal')?.addEventListener('click', function (e) {
                if (e.target === this) {
                    closeChangePasswordModal();
                }
            });

            // Close modal on ESC key press
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    const changePassModal = document.getElementById('changePasswordModal');
                    const editProfileModal = document.getElementById('editProfileModal');
                    const achievementModal = document.getElementById('achievementDetailModal');

                    if (changePassModal && !changePassModal.classList.contains('hidden')) {
                        closeChangePasswordModal();
                    } else if (editProfileModal && !editProfileModal.classList.contains('hidden')) {
                        closeEditProfileModal();
                    } else if (achievementModal && !achievementModal.classList.contains('hidden')) {
                        closeAchievementModal();
                    }
                }
            });
        </script>

