---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <!-- Page Title: Transaction Room - JDK Rekber -->
    <main class="max-w-4xl mx-auto px-4 py-8">
        <!-- Transaction Header Box -->
        <div class="bg-white border-4 border-black rounded-3xl shadow-hard p-6 mb-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
                <div>
                    <h2 id="productTitle" class="text-2xl font-black uppercase tracking-tighter leading-none mb-2">
                        LOADING...</h2>
                    <div class="flex items-center gap-3">
                        <span id="transactionId"
                            class="text-[10px] font-bold text-black/40 uppercase tracking-widest">TRX-ID: ---</span>
                        <div id="statusPill" class="status-pill status-REQUESTED">REQUESTED</div>
                    </div>
                </div>
                <div class="text-right">
                    <div id="transactionAmount" class="text-3xl font-black text-comic-red italic">Rp 0</div>
                    <div id="adminFeeDisplay" class="text-[10px] font-bold text-gray-400 uppercase">FEE: Rp 0</div>
                </div>
            </div>

            <!-- Tracker View (Desktop) -->
            <div class="hidden md:flex items-center justify-between px-2 mb-2">
                <div class="progress-dot complete" title="Rekber Diajukan"></div>
                <div class="progress-line"></div>
                <div id="dot-approved" class="progress-dot" title="Seller Approve"></div>
                <div class="progress-line"></div>
                <div id="dot-payment" class="progress-dot" title="Sudah Bayar"></div>
                <div class="progress-line"></div>
                <div id="dot-shipping" class="progress-dot" title="Sedang Dikirim"></div>
                <div class="progress-line"></div>
                <div id="dot-finished" class="progress-dot" title="Selesai"></div>
            </div>
            <div class="hidden md:flex justify-between text-[8px] font-bold uppercase text-black/40 px-1 mb-4">
                <span>Request</span>
                <span>Approved</span>
                <span>Payment</span>
                <span>Shipping</span>
                <span>Finish</span>
            </div>

            <!-- Tracker View (Mobile Scrollable) -->
            <div class="md:hidden rekber-mobile-tracker">
                <div class="rekber-step-item complete">
                    <div class="rekber-step-dot"></div>
                    <span class="rekber-step-text">REQ</span>
                </div>
                <!-- Lines are implicit/removed for cleaner mobile look -->
                <div id="mob-dot-approved" class="rekber-step-item">
                    <div class="rekber-step-dot"></div>
                    <span class="rekber-step-text">APPR</span>
                </div>
                <div id="mob-dot-payment" class="rekber-step-item">
                    <div class="rekber-step-dot"></div>
                    <span class="rekber-step-text">PAY</span>
                </div>
                <div id="mob-dot-shipping" class="rekber-step-item">
                    <div class="rekber-step-dot"></div>
                    <span class="rekber-step-text">SHIP</span>
                </div>
                <div id="mob-dot-finished" class="rekber-step-item">
                    <div class="rekber-step-dot"></div>
                    <span class="rekber-step-text">DONE</span>
                </div>
            </div>

            <!-- Dynamic Instruction Box -->
            <div id="instructionBox"
                class="bg-yellow-100 border-2 border-dashed border-yellow-600 rounded-2xl p-4 flex gap-3 items-center">
                <div class="bg-yellow-600 text-white w-8 h-8 rounded-full flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-sm">lightbulb</span>
                </div>
                <div>
                    <p class="text-[10px] font-black uppercase text-yellow-800 tracking-tighter mb-0.5">Langkah
                        Selanjutnya:</p>
                    <p id="instructionText" class="text-xs font-bold leading-tight text-yellow-900">Memuat panduan...
                    </p>
                </div>
            </div>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
            <!-- Party Info (Left Col - Collapsible on Mobile) -->
            <div class="md:col-span-1 space-y-4">
                <!-- Mobile Toggle -->
                <div class="md:hidden mobile-collapsible-header"
                    onclick="document.getElementById('mobilePartyContent').classList.toggle('open'); document.getElementById('collapseArrow').innerText = document.getElementById('mobilePartyContent').classList.contains('open') ? 'expand_less' : 'expand_more'">
                    <span class="text-xs font-black uppercase">👥 Detail Transaksi & Peserta</span>
                    <span id="collapseArrow" class="material-symbols-outlined">expand_more</span>
                </div>

                <div id="mobilePartyContent" class="mobile-collapsible-content md:block">
                    <div class="bg-white border-4 border-black rounded-2xl p-4 shadow-sm">
                        <p class="text-[10px] font-black uppercase text-black/40 mb-3">Pihak Terlibat</p>

                        <div class="space-y-4">
                            <!-- Buyer -->
                            <div class="flex items-center gap-3">
                                <img id="buyerAvatar" src="https://api.dicebear.com/7.x/avataaars/svg?seed=buyer"
                                    class="w-10 h-10 rounded-full border-2 border-black bg-yellow-400">
                                <div>
                                    <p class="text-[10px] font-black text-black/40 uppercase">Pembeli</p>
                                    <p id="buyerName" class="font-bold text-sm">@buyer</p>
                                </div>
                            </div>
                            <!-- Seller -->
                            <div class="flex items-center gap-3">
                                <img id="sellerAvatar" src="https://api.dicebear.com/7.x/avataaars/svg?seed=seller"
                                    class="w-10 h-10 rounded-full border-2 border-black bg-blue-400">
                                <div>
                                    <p class="text-[10px] font-black text-black/40 uppercase">Penjual</p>
                                    <p id="sellerName" class="font-bold text-sm">@seller</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shipping / Order Details -->
                <div id="shippingCard" class="bg-white border-4 border-black rounded-2xl p-4 shadow-sm hidden">
                    <p class="text-[10px] font-black uppercase text-black/40 mb-3 text-center">Info Pengiriman</p>
                    <div class="space-y-2">
                        <div class="bg-gray-50 p-3 rounded-xl border-2 border-dashed border-black/10">
                            <p class="text-[10px] font-black uppercase mb-1">Nomor Resi</p>
                            <p id="receiptNumber" class="font-black text-sm tracking-tighter">BELUM ADA</p>
                        </div>
                    </div>
                </div>

                <button id="btnPanic"
                    class="w-full bg-red-100 text-red-600 p-4 rounded-2xl border-2 border-red-500 border-dashed font-black uppercase text-xs hover:bg-red-500 hover:text-white transition-all">
                    🚨 Panggil Bantuan Admin
                </button>
            </div>

            <!-- Chat Room (Right Col) -->
            <div class="md:col-span-2">
                <div
                    class="bg-white border-4 border-black rounded-3xl shadow-hard flex flex-col relative overflow-hidden">
                    <!-- Chat Header -->
                    <div class="p-4 border-b-4 border-black bg-gray-50 flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">forum</span>
                            <span class="font-black uppercase tracking-tighter text-sm">Discussion Room</span>
                        </div>
                        <div class="flex items-center gap-1">
                            <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                            <span class="text-[10px] font-bold text-green-600 uppercase">Live Room</span>
                        </div>
                    </div>

                    <!-- Messages Container -->
                    <div id="chatMessages" class="chat-container overflow-y-auto p-6 flex flex-col gap-4 bg-[#fdfdfd]">
                        <!-- Messages Injected by JS -->
                    </div>

                    <!-- Input Area -->
                    <div class="p-4 bg-white border-t-4 border-black">
                        <!-- Context Actions (Upload proofs etc) -->
                        <div id="contextActions" class="mb-3 flex flex-wrap gap-2">
                            <!-- Injected by JS based on status -->
                        </div>

                        <form id="chatForm" class="flex gap-2">
                            <input type="text" id="chatInput" placeholder="Tulis pesan ke lawan transaksi..."
                                class="flex-1 bg-white border-3 border-black rounded-xl px-4 py-2 font-bold text-sm focus:ring-0 focus:border-primary transition-all shadow-[2px_2px_0_#000]">

                            <button type="button" id="btnUploadImage"
                                class="bg-white border-3 border-black text-black px-3 rounded-xl shadow-[2px_2px_0_#000] hover:translate-y-0.5 hover:shadow-none transition-all">
                                <span class="material-symbols-outlined">image</span>
                            </button>

                            <button type="submit"
                                class="bg-primary text-black px-6 rounded-xl border-3 border-black shadow-[2px_2px_0_#000] hover:translate-y-0.5 hover:shadow-none transition-all font-black uppercase tracking-tighter">
                                Kirim
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

</Layout>

<style is:global>

        .chat-container {
            height: calc(100vh - 350px);
            min-height: 400px;
        }

        .message-bubble {
            max-width: 85%;
            padding: 0.75rem 1rem;
            border-radius: 1.25rem;
            border: 2px solid black;
            box-shadow: 4px 4px 0 #000;
            position: relative;
        }

        .message-system {
            background: #F3F4F6;
            border: 2px dashed #9CA3AF;
            box-shadow: none;
            text-align: center;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            color: #4B5563;
            margin: 1rem auto;
            max-width: 90%;
        }

        .status-pill {
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.65rem;
            font-weight: 900;
            text-transform: uppercase;
            border: 2px solid black;
            box-shadow: 2px 2px 0 #000;
        }

        /* Status colors */
        .status-REQUESTED {
            background: #E5E7EB;
        }

        .status-APPROVED {
            background: #DBEAFE;
        }

        .status-WAITING_PAYMENT {
            background: #FEF3C7;
        }

        .status-VERIFYING {
            background: #FDE68A;
        }

        .status-ON_SHIPPING {
            background: #D1FAE5;
        }

        .status-DELIVERED {
            background: #A7F3D0;
        }

        .status-FINISHED {
            background: #BBF7D0;
        }

        .status-DISPUTE {
            background: #FEE2E2;
        }

        .status-CANCELLED {
            background: #F3F4F6;
            color: #9CA3AF;
        }

        .progress-line {
            height: 4px;
            background: #E5E7EB;
            flex-grow: 1;
            margin: 0 0.5rem;
            border-radius: 2px;
        }

        .progress-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #E5E7EB;
            border: 2px solid black;
        }

        .progress-dot.active {
            background: #FFE900;
            transform: scale(1.3);
            box-shadow: 0 0 10px rgba(255, 233, 0, 0.5);
        }

        .progress-dot.complete {
            background: #000;
        }
    
</style>
